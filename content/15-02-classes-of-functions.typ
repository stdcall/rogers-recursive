#import "main-defs.typ": (
  cross, idx, notation, roman, section, source, spaced, subheading, tuple,
)
#import "statements.typ": corollary, definition, example, proof, run-in, theorem

#section[Иерархия классов функций] <sec:hierarchy-of-classes-of-functions>

#idx(
  "Арифметическая",
  "иерархия",
  "классов множеств",
  "функций",
  en: "of sets of functions",
  range: "start",
)Можно определить иерархию классов функций. Мы проведем наше исследование
параллельно~§~@sec:hierarchy-of-classes-of-sets.

Пусть $cal(F)$#notation([$cal(F)$ (пространство Бэра)])~— множество всех всюду
определенных функций одного числового аргумента, т.~е. множество всех всюду
определенных функций, отображающих $N$ в $N$. Определим $cal(F)^k cross N^l$
таким же образом, как $cal(N)^k cross N^l$ (заменив $cal(N)$ на $cal(F)$).
Определим _функцию $k$ функциональных переменных и $l$ числовых переменных_#idx(
  "Функция",
  "$k$ функциональных и $l$ числовых переменных",
  en: "of k function variables and l number variables",
) таким же образом, как функцию $k$ множественных переменных и $l$ числовых
переменных (с заменой $cal(N)$ на $cal(F)$). Такие функции иногда называют
_функционалами_#idx("Функционал", en: "functional") (§~@sec:functionals).
Функцию $k$ функциональных переменных и $l$ числовых переменных, область
определения которой есть $cal(F)^k cross N^l$, назовем _всюду определенной
функцией_ ($k$ функциональных переменных и $l$ числовых переменных).

Неформальное определение _частичнорекурсивной функции $k$ функциональных
переменных и $l$ числовых переменных_#idx(
  "Частичнорекурсивные",
  "функции",
  "$k$ функциональных и $l$ числовых переменных",
  en: "partial recursive functions of k function variables and "
    + "l number variables",
) аналогично определению частичнорекурсивной функции $k$ множественных
переменных и $l$ числовых переменных (в~§~@sec:hierarchy-of-classes-of-sets),
только вместо оракулов#idx(
  "Оракулы и машины с оракулами",
  en: "oracles and oracle machine",
) для $X_1, ..., X_k$ используются оракулы для $tau(f_1), ..., tau(f_k)$ (где
$f_1, ..., f_k$~— функциональные аргументы). Отметим следующие отличительные
особенности случая функциональных переменных; если дан оракул для $tau(f)$, то
можно не только получать ответы на вопросы типа „_содержится ли_ $tuple(x, y)$
_в_ $f$?“, но и „вычислять“ $f$. Для данного $x$ можем найти $f(x)$, задавая по
порядку вопросы: „_содержится ли_ $tuple(x, 0)$ _в_ $f$?“, „_содержится ли_
$tuple(x, 1)$ _в_ $f$?“ ... Если $f$ всюду определена, то когда-нибудь оракул
даст положительный ответ. Как мы увидим, эта особенность вычисления функций
придает специфические черты иерархии классов функций.

Формальное определение _частичнорекурсивной функции $k$ функциональных
переменных и $l$ числовых переменных_ аналогично определению для множественных
переменных в~§~@sec:hierarchy-of-classes-of-sets.

#definition[
  Пусть $k > 0$ и $l > 0$. Функция $psi$ называется _частичнорекурсивной
  функцией $k$ функциональных переменных и #source(445)$l$ числовых переменных,
  если_ для некоторого $z$
  $
    psi = lambda f_1 ... f_k x_1 ... x_l [phi_z^(f_1, ..., f_k) (x_1, ...,
        x_l)].
  $

  Пусть $k > 0$ (и $l = 0$), тогда $psi$ называется _частичнорекурсивной
  функцией $k$ функциональных переменных_, если для некоторого $z$ выполняется
  $psi = lambda f_1 ... f_k [phi_z^(f_1, ..., f_k) (0)]$.

  Число $z$ называется _гёделевым номером_ или _индексом_ функции $psi$.
]

Очевидна связь введенных понятий с понятиями, введенными
в~§~@sec:hierarchy-of-classes-of-sets, так как по определению
$phi_z^(f_1, ..., f_k) = phi_z^(tau(f_1), ..., tau(f_k))$. Так, например, $psi$
является частичнорекурсивной функцией одной функциональной переменной тогда и
только тогда, когда существует такая частичнорекурсивная функция $phi$ одной
множественной переменной, что $psi = lambda f
[phi(tau(f))]$. Заметим, что $phi_z^f$ может быть всюду определенной для любых
$f$, в то время как $phi_z^X$ не является всюду определенной для всех $X$
(пример очевиден).

#definition[
  Отношение $R subset cal(F)^k cross N^l$ называется _рекурсивным_, если
  характеристическая функция отношения $R$ является всюду определенной
  рекурсивной функцией $k$ функциональных переменных и $l$ числовых переменных.
]

#example[
  Класс ${f | f(5) != 0}$ рекурсивен (хотя ${X | (exists y)[y != 0 \&
      chevron.l 5, y chevron.r in X]}$ не является рекурсивным классом
  множеств).
] <exm:fifth-value-nonzero>

#example[
  Если $A$ рекурсивно, то класс ${f | f(5) in A}$ рекурсивен.
] <exm:fifth-value-in-set>

#example[
  Отношение ${tuple(f, g) | f(g(5)) = 0}$ рекурсивно, и класс
  ${f | f(f(5)) = 0}$ рекурсивен.
] <exm:value-at-value>

#example[
  Класс ${f | f(0) = mu y [0 < y \& 0 < f(y)]}$ рекурсивен.
] <exm:first-positive-value>

Эти примеры показывают, что, вообще говоря, рекурсивные классы функций более
сложны по структуре, чем рекурсивные классы множеств.

#example[
  Класс ${f | 5 in op("Val") f}$ является областью определения
  частичнорекурсивной функции одного функционального переменного
  (упр.~@ex:value-five-domain).
] <exm:five-in-range>

#subheading[Иерархия]

Определим иерархию, применяя операции взятия дополнения и проектирования по
числовым переменным к рекурсивным отношениям. В гл.~@ch:analytical-hierarchy
будут рассмотрены проекции по функциональным переменным (см. также
упр.~@ex:analytical-sets-two-definitions).

#definition[
  #source(446)Отношение $R subset cal(F)^k cross N^l$ назовем
  _арифметическим_#idx(
    "Арифметические множества и отношения",
    en: "arithmetical sets and relations",
    range: "start",
  ), если $R$ рекурсивно или существует такое рекурсивное отношение $S subset
  cal(F)^k cross N^m$, что $R$ можно получить из $S$ путем применения конечной
  последовательности операций взятия дополнения и проектирования#idx(
    "Проекция",
    ", проектирование, взятие проекции",
    en: "projection",
  ), причем проектирования производятся только по числовым переменным.
]

Аналог теоремы~@th:class-arithmetical-quantifier-form очевиден.

#theorem[
  Отношение $R subset cal(F)^k cross N^l$ арифметическое $<=> [$отношение $R$
  рекурсивно или при некотором $m > 0$ имеем $R = {tuple(f_1, ..., x_l) |
    (upright(Q)_1 x_(l+1)) ... (upright(Q)_m x_(l+m)) S(f_1, ..., x_(l+m))}$,
  где $upright(Q)_i$ есть $forall$ или $exists$ $(1 <= i <= m)$, а отношение
  $S subset cal(F)^k cross N^(l+m)$ рекурсивно$]$.
] <th:function-arithmetical-quantifier-form>

#proof[
  Проводится аналогично доказательству теоремы~@th:hierarchy-quantifier-form.
]

Точно так же, как $Sigma_n^"(s)"$-формы и $Pi_n^"(s)"$-формы, определяются
_$Sigma_n^"(fn)"$-формы_ и _$Pi_n^"(fn)"$-формы_#idx(
  "$Sigma_n^\"(fn)\"$-, $Pi_n^\"(fn)\"$-формы",
). (Верхний индекс (fn) говорит о возможном присутствии функциональных
переменных.) _Выразимость_ в данной форме определяется, как раньше.

#definition[
  $Sigma_n^"(fn)"$#notation($Sigma_n^"(fn)", Pi_n^"(fn)"$)~— класс всех
  отношений, выразимых в $Sigma_n^"(fn)"$-форме. $Pi_n^"(fn)"$~— класс всех
  отношений, выразимых в $Pi_n^"(fn)"$-форме.
]

#corollary[
  Отношение $R subset cal(F)^k cross N^l$ арифметическое $<=> (exists n)[R in
  Sigma_n^"(fn)"$ или $R in Pi_n^"(fn)"]$.
] <cor:function-arithmetical-sigma-pi>

#proof(head: none)[
  #spaced[Доказательство] очевидно.
]

Используя фиктивные кванторы, получаем следующее.

#theorem[
  #roman[(a)] $Sigma_n^"(fn)" union Pi_n^"(fn)" subset Sigma_(n+1)^"(fn)" inter
  Pi_(n+1)^"(fn)"$.

  #roman[(b)] $R in Sigma_n^"(fn)" <=> overline(R) in Pi_n^"(fn)"$.
] <th:function-sigma-pi-inclusions>

#proof(head: none)[
  #spaced[Доказательство] проводится, как в теореме~@th:sigma-pi-inclusions.
]

#subheading[Нормальные формы]

Правила сжатия кванторов#idx(
  "Сжатие (склеивание) кванторов",
  en: "contraction of quantifiers",
) действуют, как раньше.

#definition[
  Пусть $k > 0$ и $l >= 0$, положим#notation($T'_(k, l)$)
  $
    T'_(k, l) = {tuple(f_1, ..., f_k, z, x_0, ..., x_l) | \
      tuple(tau(f_1), ..., tau(f_k), z, x_0, ..., x_l) in T_(k, l)}.
  $
]

#definition(word: "Соглашение")[
  Как и для $T_(k, l)$, вместо $T'_(k, l)(f_1, ..., f_k, z, x_0, ..., x_l)$ мы
  будем писать
  $ T'_(k, l)(z, f_1, ..., f_k, x_0, ..., x_l). $
]

Следующие теоремы являются аналогами теорем~@th:class-sigma-one-domains
и~@th:class-normal-form-enumeration#idx(
  "Арифметическая",
  "иерархия",
  "теоремы о нормальной форме и перечислимости",
  en: "normal form and enumeration theorems",
).

#theorem[
  #source(447)Пусть $R subset cal(F)^k cross N^l$. Тогда $R in Sigma_1^"(fn)"
  <=> R = op("Arg") psi$ для некоторой частичнорекурсивной функции $psi$ ($k$
  функциональных переменных и $l$ числовых переменных).
] <th:function-sigma-one-domains>

#proof(head: none)[
  #spaced[Доказательство] проводится, как в теореме~@th:class-sigma-one-domains.
]

#theorem(title: [Клини#idx("Клини", en: "Kleene S.")])[
  #idx(
    "Арифметическая",
    "иерархия",
    "теоремы о нормальной форме и перечислимости",
    en: "normal form and enumeration theorems",
  )Для любого $n > 0$ и любого отношения $R in Sigma_n^"(fn)"$ (#roman[где]
  $R subset cal(F)^k cross N^l$) существует такое число $z$, что
  $
    R = {tuple(f_1, ..., f_k, x_0, ..., x_(l-1)) | & (exists x_l)
      (forall x_(l+1))(exists x_(l+2)) ... \
      & ... T'_(k, l+n-1)(z, f_1, ..., f_k, x_0, ..., x_(l+n-1))}
  $
  (перед $T$ стоит знак отрицания, если $n$ четно). Назовем $z$
  $Sigma_n^"(fn)"$-индексом отношения $R$. По любой $Sigma_n^"(fn)"$-форме
  отношения $R$ (см. теорему~@th:class-normal-form-enumeration) можно равномерно
  найти $Sigma_n^"(fn)"$-индекс отношения $R$. Аналогичное предложение имеет
  место и для $R in Pi_n^"(fn)"$ $(n > 0)$.
] <th:function-normal-form-enumeration>

#proof(head: none)[
  #spaced[Доказательство] очевидно.
]

#subheading[Алгоритм Тарского~— Куратовского]

#definition[
  #idx(
    "Тарского — Куратовского алгоритм",
    en: "Tarski — Kuratowski algorithm",
  )Пусть выражение $F(p_1, ..., p_k, a_1, ..., a_l)$ построено в логике
  предикатов#idx("Логика", "предикатов", en: "quantificational logic") из
  пропозициональных связок, $=$, числовых переменных, кванторов по числовым
  переменным, переменных $p_1, ..., p_k$ для функций (одной переменной) и
  переменных для отношений (на функциях и числах), и пусть $a_1, ..., a_l$
  являются свободными числовыми переменными этого выражения. Пусть переменные
  для отношений интерпретируются, как конкретные отношения $S_1$, $S_2, ...$.

  Будем говорить, что отношение
  $
    R = { & tuple(f_1, ..., f_k, x_1, ..., x_l) | F(p_1, ..., p_k, a_1, ...,
              a_l) \
          & quad #emph[истинно, если] p_1, ..., a_l #emph[интерпретируются как]
            f_1, ..., x_l \
          & quad #emph[соответственно]}
  $
  _определимо в логике предикатов#idx(
    "Определимость",
    "в логике предикатов",
    en: "within quantificational logic",
  ) через $S_1$, $S_2, ...$ с кванторами только по числовым переменным_, а
  выражение $F(p_1, ..., a_l)$ будем называть _определением_ отношения $R$ через
  $S_1$, $S_2, ...$. Заметим, что допускается _гнездность_ функциональных
  переменных, например, $(exists b)[p(p(b)) = a]$ определяет отношение
  ${tuple(f, x) | x in op("Val") lambda y [f f(y)]}$.
]

Имеет место следующий аналог теоремы~@th:class-predicate-definable.

#theorem[
  Если $R subset cal(F)^k cross N^l$ определимо в логике предикатов через
  рекурсивные отношения, с кванторами только по числовым переменным, то $R$
  является арифметическим отношением.
] <th:function-predicate-definable>

#proof(head: none)[
  #source(448)#spaced[Доказательство] проводится, как в
  теореме~@th:class-predicate-definable#footnote[
    В силу теоремы~@th:function-arithmetical-quantifier-form обращение
    теоремы~@th:function-predicate-definable очевидно.
  ].
]

Следовательно, можно, как и раньше, использовать алгоритм Тарского~—
Куратовского.

#example(restart: true)[
  Рассмотрим множество ${f mid(|) op("Val") f$ _бесконечна_$}$. Тогда
  $op("Val") f$ бесконечна $<=>$
  $
    & <=> (forall x)(exists y)[y > x \& y in op("Val") f] <=> \
    & <=> (forall x)(exists y)[y > x \& exists z [f(z) = y]] <=> forall exists
      exists <=> forall exists,
  $
  следовательно, это множество функций входит в $Pi_2^"(fn)"$.
] <exm:infinite-range>

#example[
  Рассмотрим множество ${f | f$~— _общерекурсивная функция_$}$. Имеем: всюду
  определенная функция $f$ рекурсивна $<=>$
  $
    & <=> (exists z)[f = phi_z] <=> (exists z)(forall x)[f(x) = phi_z (x)] <=> \
    & <=> (exists z)(forall x)(exists y)(exists w)[phi_z (x) = y "за" w "шагов"
        \& y = f(x)] <=>
  $
  $<=> exists forall exists$, следовательно, это множество функций входит в
  $Sigma_3^"(fn)"$.
] <exm:general-recursive-functions>

#subheading[Представимость]

#theorem[
  Пусть $R subset cal(F)^k cross N^l$#idx(
    "Представимость, представление",
    en: "representation",
  ).

  #roman[(a)] Отношение $R$ арифметическое $<=>$ отношение $R$ определимо в
  логике предикатов#idx(
    "Определимость",
    "в логике предикатов",
    en: "within quantificational logic",
  ) через рекурсивные отношения на числах и отношение ${tuple(f, x, y) | f(x) =
    y}$ с кванторами только по числовым переменным.

  #roman[(b)] Расширим элементарную арифметику#idx(
    "Элементарная",
    "арифметика",
    en: "elementary arithmetic",
  ), введя унарные операторные символы (т.~е. функциональные переменные) $p_1$,
  $p_2, ...$. Тогда отношение $R$ арифметическое $<=>$ отношение $R$ определимо
  в расширенной таким образом элементарной арифметике.
] <th:function-representability>

#proof[
  (a) $arrow.l.double$. Очевидно в силу
  теоремы~@th:function-predicate-definable.

  $=>$. Доказательство проводится, как в теореме~@th:class-representability;
  заметим, что
  $
    D_u subset tau(f) <=> (forall x)(forall y)[chevron.l x, y chevron.r in D_u
      => f(x) = y].
  $

  (b) $arrow.l.double$. В силу теоремы~@th:function-predicate-definable. Хотя и
  возможна гнездность операторных символов, но любое такое гнездо определяет
  рекурсивное отношение.

  $=>$. Согласно (a) и теореме~@th:representation#idx(
    "Арифметические множества и отношения",
    en: "arithmetical sets and relations",
    range: "end",
  ).
]

#subheading[Топология]

#idx("Топология", en: "topology")В дальнейшем для простоты мы ограничимся
отношениями с одной функциональной переменной и без числовых переменных, т.~е.
множествами функций. Иногда (но не всегда) мы такие мно#source(449)жества будем
называть _классами_ функций#idx(
  "Классы функций и множеств",
  en: "classes of functions and sets",
). Для их обозначения будем использовать буквы $cal(A)$, $cal(B)$, $cal(C)$,
$...$. Прежде чем переходить к теореме об иерархии, мы введем топологию#idx(
  "Топология",
  en: "topology",
) на $cal(F)$, аналогичную топологии на $cal(N)$. Как мы увидим, топологические
пространства $cal(F)$ и $cal(N)$ сильно отличаются.

#definition[
  Определим в $cal(F)$ _бэровскую метрику_#idx(
    "Бэровская метрика",
    en: "Baire metric",
  ). Положим
  $
    d(f, g) = cases(
      0\, & "если" quad f = g";",
      1 / (mu x [f(x) != g(x)] + 1)\, & "если" quad f != g.
    )
  $
]

Функция $d$ является метрикой, а пространство $cal(F)$ (с такой метрикой)
является полным метрическим пространством#idx(
  "Полное",
  "метрическое пространство",
  en: "complete metric space",
) (упр.~@ex:baire-metric-complete). Следовательно, можно применять
теорему~@th:baire и можно пользоваться доказательствами, использующими понятие
категории#idx(
  "Категорные методы",
  en: "category methods",
). Пространство $cal(F)$ принято называть _бэровским пространством_#idx(
  "Бэровское",
  "пространство",
  en: "Baire space",
).

Ту же самую топологию на $cal(F)$ можно получить, если взять дискретную
топологию на $N$ и, учитывая, что $cal(F) = N^N$, рассмотреть произведение
топологий на $N^N = N cross N cross ...$
(упр.~@ex:product-topology-baire-metric).

Элементы пространства $cal(F)$ можно отождествить с иррациональными числами#idx(
  "Иррациональные числа",
  en: "irrationals",
), лежащими между 0 и 1, с помощью бесконечных непрерывных цепных дробей#idx(
  "Представление цепными дробями",
  en: "continued fraction representation",
) (упр.~@ex:continued-fractions). Топология $cal(F)$ как бэровского пространства
будет изоморфна топологии на иррациональных числах, индуцированной обычной
топологией на действительных числах. (Разумеется, в метрике действительных чисел
пространство $cal(F)$ не полно#footnote[
  Как известно, пространство может быть полным в одной метрике и неполным в
  другой метрике, хотя обе метрики дают одну и ту же топологию.
].) Для наглядности бэровское пространство можно рассматривать как пространство
всех бесконечных ветвей в функциональном дереве (см. ниже и
упр.~@ex:function-tree), при этом топология порождается следующей базой:
базисные окрестности~— это классы вида ${f | tilde(f) subset f}$, где
$tilde(f)$~— конечный начальный сегмент.

#definition[
  Класс функций $cal(A)$ назовем _базисной окрестностью_#idx(
    "Базисные окрестности",
    en: "basic neighborhoods",
  ), если $cal(A) = {f | tilde(f) subset f}$ для некоторого конечного начального
  сегмента $tilde(f)$ (упр.~@ex:basic-neighborhoods-base).
]

Пространство $cal(F)$ не компактно#idx("Компактность", en: "compactness")
(упр.~@ex:baire-space-not-compact). С этим фактом связаны некоторые важные
различия между арифметической иерархией классов функций и арифметической
иерархией классов множеств.

#subheading[Открыто-замкнутые классы]

#idx(
  "Открыто-замкнутые множества и классы",
  en: "open-and-closed sets and classes",
)Пусть $cal(T)^*$~— _функциональное дерево_#idx(
  "Функциональное дерево",
  en: "function tree",
), определенное в упр.~@ex:function-tree. Определим _поддерево_#idx(
  "Поддерево",
  en: "subtree",
) и _ветвь_#idx(
  "Ветвь дерева",
  en: "branch of a tree",
), как в упр.~@ex:function-tree. Каждую ветвь дерева $cal(T)^*$ можно
отождествить с элементом из $cal(F)$ (и наоборот). #source(450)_Подветвь_#idx(
  "Подветвь дерева",
  en: "subbranch of a tree",
)~— это начальный сегмент ветви. Каждая вершина дерева $cal(T)^*$ определяет
конечную подветвь дерева $cal(T)^*$ (и наоборот), каждую конечную подветвь
дерева $cal(T)^*$ можно отождествить с конечным начальным сегментом всюду
определенной функции (и наоборот). Таким образом, каждая конечная подветвь
дерева $cal(T)^*$ определяет базисную окрестность в $cal(F)$ (и наоборот), при
этом окрестность, определяемая данной конечной подветвью, состоит из тех
функций, которые соответствуют ветвям дерева $cal(T)^*$, начинающимся данной
подветвью.

#definition[
  Поддерево $cal(T)$ дерева $cal(T)^*$ назовем _деревом с конечными путями_#idx(
    "Деревья",
    "с",
    "конечными",
    "путями",
    en: "finite-path trees",
  ), если любая ветвь дерева $cal(T)$ конечна.
]

#theorem[
  Класс $cal(A) (subset cal(F))$ открыто-замкнут#idx(
    "Классы функций и множеств",
    "замкнутые",
    en: "closed",
  ) $<=>$ существует такое дерево с конечными путями $cal(T)$, что $cal(A)$ есть
  объединение всех окрестностей, определяемых ветвями дерева $cal(T)$.
] <th:clopen-finite-path-trees>

#proof[
  $arrow.l.double$. Для любой непустой конечной подветви $f$ дерева $cal(T)^*$
  символом $f^-$ обозначим конечную подветвь, получаемую из $f$ отбрасыванием
  последнего элемента ветви $f$. Пусть дано дерево с конечными путями $cal(T)$,
  и пусть $cal(A)$~— объединение всех окрестностей, определяемых ветвями дерева
  $cal(T)$. Рассмотрим совокупность всех таких конечных подветвей $f$ дерева
  $cal(T)^*$, что (i) подветвь $f$ не является подветвью дерева $cal(T)$; (ii)
  если существует $f^-$ (т.~е. если $f != emptyset$), то $f^-$~— подветвь дерева
  $cal(T)$, но $f^-$ не является ветвью дерева $cal(T)$. Пусть $cal(T)'$~—
  объединение подветвей из этой совокупности. Тогда $cal(T)'$~— дерево с
  конечными путями, так как всякая бесконечная ветвь дерева $cal(T)'$ была бы
  ветвью дерева $cal(T)$, что противоречило бы условию, что $cal(T)$~— дерево с
  конечными путями. По определению никакая ветвь дерева $cal(T)'$ не начинает
  ветви дерева $cal(T)$ и никакая ветвь дерева $cal(T)$ не начинает ветви дерева
  $cal(T)'$. Кроме того, всякая ветвь дерева $cal(T)^*$ начинается или ветвью
  дерева $cal(T)$, или ветвью дерева $cal(T)'$. Следовательно, $cal(A)$~—
  объединение окрестностей, определяемых ветвями дерева $cal(T)$, а
  $overline(cal(A))$~— объединение окрестностей, определяемых ветвями дерева
  $cal(T)'$. Итак, $cal(A)$~— открыто-замкнутый класс#footnote[
    Заметим, что это доказательство проходит для частных случаев $cal(T) =
    {emptyset}$ (дерево $cal(T)$ состоит из пустого кортежа) и $cal(T) =
    emptyset$ (дерево $cal(T)$ пусто). Если $cal(T) = {emptyset}$, то
    $cal(T)' = emptyset$, $cal(A) = cal(F)$ и $overline(cal(A)) = emptyset$.
    Если $cal(T) = emptyset$, то $cal(T)' = {emptyset}$, $cal(A) = emptyset$ и
    $overline(cal(A)) = cal(F)$.
  ].

  $=>$. Пусть $cal(A)$~— открыто-замкнутый класс. Каждой функции $f$ в $cal(F)$
  сопоставим _самый короткий_ конечный начальный сегмент $tilde(f)$ функции $f$,
  такой, что или ${f | tilde(f) subset f} subset cal(A)$, или
  ${f | tilde(f) subset f} subset overline(cal(A))$. Такой сегмент $tilde(f)$
  всегда существует, так как и $overline(cal(A))$, и $cal(A)$ открыты#idx(
    "Классы функций и множеств",
    "открытые",
    en: "open",
  ). Конечные подветви дерева $cal(T)^*$, отождествляемые с этими сегмен#source(
    451,
  )тами, образуют дерево с конечными путями (так как для каждой ветви $f$ дерева
  $cal(T)^*$ выбирается конечная подветвь $tilde(f)$). Все ветви $tilde(f)$, для
  которых ${f | tilde(f) subset f} subset cal(A)$, определяют поддерево этого
  дерева с конечными путями. Следовательно, это поддерево будет деревом с
  конечными путями и $cal(A)$~— объединение всех окрестностей, определяемых
  ветвями этого поддерева.
]

#corollary[
  Существует $2^(aleph_0)$ открыто-замкнутых#idx(
    "Открыто-замкнутые множества и классы",
    en: "open-and-closed sets and classes",
  ) классов.
] <cor:continuum-clopen-classes>

#proof[
  Любое множество чисел определяет дерево с конечными путями, длина каждой ветви
  которого равна 1. Два различных таких дерева определяют различные
  открыто-замкнутые классы. Так как существует $2^(aleph_0)$ множеств чисел, то
  имеется по крайней мере $2^(aleph_0)$ открыто-замкнутых классов.

  Существует $aleph_0$ базисных окрестностей, всякий открытый#idx(
    "Классы функций и множеств",
    "открытые",
    en: "open",
  ) класс~— объединение базисных окрестностей. Следовательно, имеется самое
  большее $2^(aleph_0)$ открыто-замкнутых классов функций.
]

#subheading[$Sigma_0^"(fn)"$-классы]

Так как в $Sigma_0^"(fn)"$ содержится лишь счетное количество классов, то
теорема~@th:sigma-zero-clopen для $Sigma_0^"(fn)"$ не верна. Однако имеется
следующее необходимое условие.

#theorem[
  Класс $cal(A) in Sigma_0^"(fn)" =>$ класс $cal(A)$ открыто-замкнут#idx(
    "Классы функций и множеств",
    "замкнутые",
    en: "closed",
  ) (в топологии бэровского пространства на $cal(F)$).
] <th:function-sigma-zero-clopen>

#proof[
  Пусть $cal(A) in Sigma_0^"(fn)"$. Пусть $psi$~— характеристическая функция
  (одной функциональной переменной) класса $cal(A)$. По определению $psi$
  общерекурсивна. Поэтому $psi = lambda f [phi_z^(tau(f)) (0)]$ для некоторого
  $z$. Рассмотрим совокупность всех конечных начальных сегментов $tilde(f)$,
  таких, что (i) $phi_z^(tau(tilde(f))) (0)$ сходится, причем в этом вычислении
  задаются вопросы о $tau(tilde(f))$, включающие аргументы только из области
  определения $tilde(f)$, и (ii) $phi_z^(tau(tilde(f))) (0)$ не сходится, когда
  задаются вопросы о $tau(tilde(f))$, содержащие аргументы только из области
  определения какого-нибудь более короткого начального подсегмента сегмента
  $tilde(f)$; т.~е. (в обозначениях гл.~@ch:degrees-of-unsolvability)
  $phi_z^([tilde(f)]) (0)$ сходится, а $phi_z^([tilde(g)]) (0)$ не сходится ни
  для какого собственного начального подсегмента $tilde(g)$ сегмента $tilde(f)$.
  В силу рекурсивности множества $cal(A)$ всякая функция $f$ из $cal(F)$
  содержит такой начальный сегмент. Как в доказательстве
  теоремы~@th:clopen-finite-path-trees, эти сегменты определяют дерево с
  конечными путями и $cal(A)$~— объединение окрестностей, определяемых ветвями
  некоторого поддерева этого дерева с конечными путями. #source(
    452,
  )Следовательно, это поддерево является деревом с конечными путями и $cal(A)$~—
  открыто-замкнутый класс.
]

(Таким образом, рекурсивным классам сопоставляется некоторое счетное
подсемейство семейства всех деревьев с конечными путями. В
гл.~@ch:analytical-hierarchy мы рассмотрим это „рекурсивное“ подсемейство и
некоторые другие, связанные с ним, подсемейства.)

#corollary[
  Пусть $cal(A)$~— область определения частичнорекурсивной функции одной
  функциональной переменной. Тогда $cal(A)$~— открытый класс.
] <cor:function-domains-open>

#proof[
  Класс $cal(A)$~— объединение окрестностей, определяемых такими начальными
  сегментами $tilde(f)$, что $phi_z^([tilde(f)]) (0)$ сходится.
]

#run-in[Пример]Пусть $cal(A) = {f | 0 in op("Val") f}$. Как уже отмечалось,
$cal(A) in Sigma_1^"(fn)"$. Для любого начального сегмента $tilde(f)$ существует
такая функция $f in cal(F)$, что $tilde(f) subset f$ и что $0 in op("Val") f$;
следовательно, $overline(cal(A))$ не содержит никакой базисной окрестности и
$overline(cal(A))$ не открыто. Поэтому
$cal(A) in (Sigma_1^"(fn)" - Sigma_0^"(fn)")$.

#subheading[$Sigma_1^"(fn)"$-классы и $Pi_1^"(fn)"$-классы]

Теорема~@th:sigma-one-open-pi-one-closed сохраняется и для классов функций.

#theorem[
  #roman[(a)] Класс $cal(A) in Sigma_1^"(fn)" =>$ класс $cal(A)$ открыт.

  #roman[(b)] Класс $cal(A) in Pi_1^"(fn)" =>$ класс $cal(A)$ замкнут.
] <th:function-sigma-one-open>

#proof(head: none)[
  #spaced[Доказательство] следует из теоремы~@th:function-sigma-one-domains и
  следствия~@cor:function-domains-open.
]

#corollary[
  $cal(A) in Sigma_0^"(fn)" <=> cal(A) in Pi_0^"(fn)" <=> cal(A) in
  Sigma_1^"(fn)" inter Pi_1^"(fn)"$.
] <cor:function-sigma-zero-delta-one>

#proof[
  Из теоремы~@th:function-sigma-pi-inclusions следует, что $cal(A) in
  Sigma_0^"(fn)" => cal(A) in Pi_0^"(fn)" => cal(A) in Sigma_1^"(fn)" inter
  Pi_1^"(fn)"$. Пусть $cal(A) in Sigma_1^"(fn)" inter Pi_1^"(fn)"$. Тогда
  $cal(A) = op("Arg") psi_1$ и $overline(cal(A)) = op("Arg") psi_2$ для
  некоторых частичнорекурсивных функций (одной функциональной переменной)
  $psi_1$ и $psi_2$. С помощью следующих инструкций определим
  частичнорекурсивную функцию (одной функциональной переменной) $psi$. Пусть
  дана функция $f$ (дан оракул для $f$), начинайте вычисления $psi_1 (f)$ и
  $psi_2 (f)$; если $psi_1 (f)$ сходится раньше, чем $psi_2 (f)$, то выдайте 1,
  если $psi_2 (f)$ сходится раньше, чем $psi_1 (f)$, то выдайте 0. Функция $psi$
  является общерекурсивной функцией одной функциональной переменной и является,
  кроме того, характеристической функцией класса $cal(A)$. Следовательно,
  $cal(A) in Sigma_0^"(fn)"$.
]

#source(453)#subheading[Классическая иерархия Бореля]

#idx(
  "Борелевские",
  "множества",
  "классическая иерархия",
  en: "classical hierarchy of",
)Для множества $cal(F)$ можно определить так же, как и для множества $cal(N)$
в~§~@sec:hierarchy-of-classes-of-sets, иерархию борелевых классов.

#definition[
  $Sigma_0^(**) = Pi_0^(**) = [$семейство всех открыто-замкнутых классов,
  принадлежащих множеству $cal(F)]$.#notation($Sigma_n^(**), Pi_n^(**)$)

  $Sigma_(n+1)^(**) = [$семейство всех счетных объединений классов,
  принадлежащих $Pi_n^(**)]$.

  $Pi_(n+1)^(**) = [$семейство всех счетных пересечений классов, принадлежащих
  $Sigma_n^(**)]$.
]

#theorem[
  Каково бы ни было $n$, $[cal(A) in Sigma_n^"(fn)" => cal(A) in Sigma_n^(**)]
  \& [cal(A) in Pi_n^"(fn)" => cal(A) in Pi_n^(**)]$.
] <th:function-effective-borel-inclusion>

#proof(head: none)[
  #spaced[Доказательство] очевидно.
]

В частности, всякий класс из $Sigma_2^"(fn)"$ является множеством типа $F_sigma$
и всякий класс из $Pi_2^"(fn)"$ является множеством типа $G_delta$. (Множества
типа $F_sigma$ и $G_delta$ определяются так же, как и для иерархии в множестве
$cal(N)$.) (Имея в виду упр.~@ex:continued-fractions, иерархию Бореля в
множестве $cal(F)$ (по конечным уровням) иногда называют _конечной иерархией
борелевских множеств иррациональных чисел_.)

#run-in[Пример]Пусть $cal(A) = {f |$ _множество_ $f^(-1)(0)$ _конечно_$}$.
Объединяя алгоритм Тарского~— Куратовского с доказательствами, использующими
понятие категории, можно показать, что $cal(A) in (Sigma_2^"(fn)" -
  Pi_2^"(fn)")$. (Доказательство проводится так же, как для соответствующего
примера, приведенного после теоремы~@th:sigma-two-closed-unions
в~§~@sec:hierarchy-of-classes-of-sets. См. упр.~@ex:finite-zeros-class.)

#subheading[Теорема об иерархии]

Теорема об иерархии#idx(
  "Теоремы",
  "об",
  "иерархии",
  en: "hierarchy theorems",
) для классов функций получается легче (из теоремы~@th:strong-hierarchy), чем
соответствующая теорема об иерархии для классов множеств.

#theorem[
  Для любого $n > 0$ можно указать такой класс $cal(A)$, что $cal(A) in
  (Sigma_n^"(fn)" - Pi_n^"(fn)")$ (и что, следовательно, $overline(cal(A)) in
  (Pi_n^"(fn)" - Sigma_n^"(fn)")$).
] <th:function-hierarchy>

#proof[
  Для любого множества $B$ положим $cal(A)_B = {f | f(0) in B}$. Покажем, что
  для любого $n$ имеет место следующее: (i) $cal(A)_B in Sigma_n^"(fn)" <=> B
  in Sigma_n$; и (ii) $cal(A)_B in Pi_n^"(fn)" <=> B in Pi_n$.

  $arrow.l.double$. Пусть $B = {x | (upright(Q)_1 x_1) ... (upright(Q)_n x_n)
    R(x, x_1, ..., x_n)}$, где $R subset N^(n+1)$~— рекурсивное отношение. Тогда
  $cal(A)_B = {f | (upright(Q)_1 x_1) ... (upright(Q)_n x_n) R(f(0), x_1,
      ..., x_n)}$. Очевидно, что отношение ${tuple(f, x_1, ..., x_n) | R(f(0),
      x_1, ..., x_n)}$~— рекурсивное отношение #source(454)в $cal(F) cross N^n$.
  Следовательно, $B in Sigma_n => cal(A)_B in Sigma_n^"(fn)"$ и $B in Pi_n =>
  cal(A)_B in Pi_n^"(fn)"$.

  $=>$. Пусть $cal(A)_B = {f | (upright(Q)_1 x_1) ... (upright(Q)_n x_n) S(f,
      x_1, ..., x_n)}$, где $S$~— рекурсивное отношение в $cal(F) cross N^n$.
  Определим $R = {tuple(x, x_1, ..., x_n) | S(lambda y [x], x_1, ..., x_n)}$.
  Очевидно, что $R$~— рекурсивное отношение в $N^(n+1)$ и что
  $ B = {x | (upright(Q)_1 x_1) ... (upright(Q)_n x_n) R(x, x_1, ..., x_n)}. $
  Следовательно, $cal(A)_B in Sigma_n^"(fn)" => B in Sigma_n$ и $cal(A)_B in
  Pi_n^"(fn)" => B in Pi_n$.

  Остается только применить теорему~@th:strong-hierarchy.
]

Заметим, что определенные в этом доказательстве классы $cal(A)_B$
открыто-замкнуты. Таким образом, на всех уровнях арифметической иерархии имеются
классы, находящиеся на уровне $Sigma_0^(**)$ в классической иерархии Бореля.

Что можно сказать о соотношении иерархии множеств функций и иерархии множеств
множеств#idx(
  "Арифметическая",
  "иерархия",
  "классов множеств",
  en: "of sets of sets",
)? В частности, какие связи имеются между классификацией классов $cal(A)
subset cal(F)$ и классификацией соответствующих классов $tau(cal(A)) subset
cal(N)$?

#theorem[
  Пусть $cal(A) subset cal(F)$.

  Для любого $n$ имеем $tau(cal(A)) in Sigma_n^"(s)" => cal(A) in
  Sigma_n^"(fn)"$.

  Для любого $n$ имеем $tau(cal(A)) in Pi_n^"(s)" => cal(A) in Pi_n^"(fn)"$.

  Если $n >= 3$, то $cal(A) in Sigma_n^"(fn)" => tau(cal(A)) in
  Sigma_n^"(s)"$.

  Если $n >= 2$, то $cal(A) in Pi_n^"(fn)" => tau(cal(A)) in Pi_n^"(s)"$.
] <th:function-classes-graphs>

#proof[
  Пусть $tau(cal(A)) = {X | (upright(Q)_1 x_1) ... (upright(Q)_n x_n) R(X, x_1,
      ..., x_n)}$, где $R$~— рекурсивное отношение в $cal(N) cross N^n$. Положим
  $S = {tuple(f, x_1, ..., x_n) | R(tau(f), x_1, ..., x_n)}$. Тогда
  $S subset cal(F) cross N^n$~— рекурсивное отношение и
  $
    cal(A) = {f | (upright(Q)_1 x_1) ... (upright(Q)_n x_n) S(f, x_1, ...,
        x_n)}.
  $
  Следовательно, $tau(cal(A)) in Sigma_n^"(s)" => cal(A) in Sigma_n^"(fn)"$ и
  $tau(cal(A)) in Pi_n^"(s)" => cal(A) in Pi_n^"(fn)"$.

  Наоборот, пусть $cal(A) in Sigma_n^"(fn)"$ и $n >= 3$. Тогда для некоторого
  $z$
  $
    cal(A) = {f | (exists x_0)(forall x_1) ... T'_(1, n-1)(z, f, x_0, ...,
        x_(n-1))}.
  $
  По определению предиката $T'$ имеем $cal(A) = {f | (exists x_0)(forall x_1)
    ... T_(1, n-1)(z, tau(f), x_0, ..., x_(n-1))}$. Тогда
  $
    tau(cal(A)) = {X | & (forall x)(forall y)(forall u)[chevron.l x, y
                           chevron.r in X \& chevron.l x, u chevron.r in X => y
                           = u] \& \
                       & \& (forall x)(exists y)[chevron.l x, y chevron.r in
                           X] \& (exists x_0)(forall x_1) ... \
                       & ... T_(1, n-1)(z, X, x_0, ..., x_(n-1))}.
  $
  #source(455)Применение алгоритма Тарского~— Куратовского дает $[forall \&
    forall exists \& exists forall exists ...] <=> exists forall exists ...$.
  Следовательно, $tau(cal(A)) in Sigma_n^"(s)"$.

  Аналогично, если $cal(A) in Pi_n^"(fn)"$ и $n >= 2$, то получаем $[forall \&
    forall exists \& forall exists ...] <=> forall exists ...$ и, следовательно,
  $tau(cal(A)) in Pi_n^"(s)"$.
]

#corollary[
  Пусть $cal(A) subset cal(F)$. Класс $cal(A)$ является арифметическим $<=>$
  класс $tau(cal(A))$ как подкласс класса $cal(N)$ является арифметическим#idx(
    "Арифметическая",
    "иерархия",
    "классов множеств",
    en: "of sets of sets",
  ).
] <cor:function-classes-graphs-arithmetical>

#proof(head: none)[
  #spaced[Доказательство] очевидно.
]

Можно также рассмотреть соотношение классификации классов $cal(A) subset
cal(N)$ и классификации соответствующих классов
$
  cal(C)(cal(A)) = {f | (exists X)[X in cal(A) \& f = c_X]} subset cal(F).
$

#theorem[
  Пусть $cal(A) subset cal(N)$.

  Для любого $n$ $cal(C)(cal(A)) in Sigma_n^"(fn)" => cal(A) in Sigma_n^"(s)"$.

  Для любого $n$ $cal(C)(cal(A)) in Pi_n^"(fn)" => cal(A) in Pi_n^"(s)"$.

  Если $n >= 2$, то $cal(A) in Sigma_n^"(s)" => cal(C)(cal(A)) in
  Sigma_n^"(fn)"$.

  Если $n >= 1$, то $cal(A) in Pi_n^"(s)" => cal(C)(cal(A)) in Pi_n^"(fn)"$.
] <th:set-classes-characteristic-functions>

#proof[
  Доказательство аналогично, в общих чертах, доказательству
  теоремы~@th:function-classes-graphs
  (упр.~@ex:characteristic-functions-theorem-proof).
]

#corollary[
  Пусть $cal(A) subset cal(N)$. Класс $cal(A)$ является арифметическим $<=>$
  класс $cal(C)(cal(A))$ как подкласс класса $cal(F)$ является арифметическим.
] <cor:set-classes-characteristic-arithmetical>

#proof(head: none)[
  #spaced[Доказательство] очевидно.
]

#subheading[Определимость и неявная определимость]

#definition[
  #idx("Определимость", "неявная", en: "implicit")Функция $f$ называется
  _арифметической_#idx(
    "Арифметическая",
    "всюду определенная функция",
    en: "arithmetical function",
  ), если $f$ как отношение является арифметическим отношением.
]

Читатель легко проверит, что для любого множества $A$ $[$множество $A$
арифметическое $<=>$ функция $c_A$ арифметическая$]$.

#definition[
  Функция $f$ _явно определима в элементарной арифметике_#idx(
    "Определимость",
    "явная",
    en: "explicit",
  ), если $f$ как отношение _определимо в элементарной арифметике_ в
  смысле~§~@sec:arithmetical-representation.
]

В силу теоремы~@th:representation функция $f$ арифметическая $<=>$ функция $f$
явно определима в элементарной арифметике. Следовательно, для любого множества
$A$ имеем: множество $A$ арифметическое $<=>$ функция $c_A$ явно определима в
элементарной арифметике. (Читатель также легко проверит следующее утверждение:
функция $f$ арифметическая $<=>$ множество $tau(f)$ арифметическое $<=>$
множество $tau(f)$ явно определимо в элементарной арифметике.)

#definition[
  #source(456)Функция $f$ _неявно определима в элементарной арифметике_#idx(
    "Определимость",
    "неявная",
    en: "implicit",
  ), если существует такое выражение $F(p)$ в расширенной элементарной
  арифметике теоремы~@th:function-representability~(b) со свободной
  функциональной переменной $p$, что $F(p)$ истинно тогда и только тогда, когда
  $p$ интерпретируется как $f$.
]

Согласно теореме~@th:function-representability, функция $f$ неявно определима в
элементарной арифметике $<=>$ класс ${f}$ является арифметическим классом. Пусть
$V$ определяется как в теореме~@th:true-arithmetic-implicit. По
теореме~@th:set-classes-characteristic-functions класс ${c_V} in
Pi_2^"(fn)"$. Следовательно, имеются неарифметические функции, неявно
определимые в элементарной арифметике, и, в частности, характеристическая
функция множества всех истинных высказываний элементарной арифметики неявно
определима в элементарной арифметике.

#subheading[Определение уровней в иерархии]

#idx(
  "Вычислимые",
  "уровни иерархии и степени неразрешимости",
  en: "computing hierarchy levels and degrees of unsolvability",
)Методы, используемые в иерархии классов множеств, можно использовать и в
иерархии классов функций. Например, доказательство, аналогичное доказательству
теоремы~@th:re-sets-class, дает, что ${f | f$ общерекурсивная функция$} in
(Sigma_3^"(fn)" - Pi_3^"(fn)")$ (см.
упр.~@ex:general-recursive-class-sigma-three).

#subheading[Релятивизация]

#idx("Релятивизация", en: "relativization")Материал этого параграфа не излагался
в релятивизованной форме. Релятивизация легко проводится, если ввести понятие
_$A$-рекурсивной функции $k$ функциональных переменных и $l$ числовых
переменных_ (например, функция $psi$ одной функциональной переменной
$A$-рекурсивна, если $psi = lambda f [phi_z^(A, tau(f)) (0)]$ для некоторого
$z$). Нормальные формы определяются с помощью предиката $T'^A_(m, n)$, где,
например, $T'^A_(1, n) = {tuple(f, z, x_0, ..., x_n) | T_(2, n)(z, A, tau(f),
    x_0, ..., x_n)}$; определение $T_(2, n)$ см.
в~§~@sec:hierarchy-of-classes-of-sets. Мы отмечали
в~§~@sec:hierarchy-of-classes-of-sets, что при релятивизации не изменяется самый
низкий уровень в иерархии классов множеств; т.~е. для любого $A$ класс
$Sigma_0^"(s)"$ совпадает с классом $Sigma_0^((upright(s)) A)$. Для классов
функций это не так: $Sigma_0^"(fn)"$ может отличаться от
$Sigma_0^((upright("fn")) A)$#notation(
  $Sigma_n^((upright("fn")) A)$,
) (см. упр.~@ex:relativized-sigma-zero-function-classes).

Ниже мы рассмотрим релятивизацию несколько другого типа.

#subheading[Обобщенная теорема об иерархии]

#idx(
  "Теоремы",
  "об",
  "иерархии",
  en: "hierarchy theorems",
)#idx(
  "Теоремы",
  "об",
  "иерархии",
  "обобщенные",
  en: "generalized",
  range: "start",
)#idx(
  "Борелевские",
  "множества",
  "классическая иерархия",
  en: "classical hierarchy of",
  range: "start",
)Аддисон~@bib:Addison1955#idx("Аддисон", en: "Addison J.") построил общую теорию
для (конечной) классической иерархии Бореля в $cal(F)$ и для арифметической
иерархии в $cal(F)$. Более конкретно, пусть $cal(C)$~— произвольный класс
множеств. Рассмотрим отношения $R subset cal(F)^k cross
N^l$.

#definition[
  #source(457)Отношение $R$ _рекурсивно в_ (_относительно_) $cal(C)$#idx(
    "Рекурсивное",
    "относительно (в)",
    en: "in",
  ), если $R$ рекурсивно относительно некоторого множества $A$ из класса
  $cal(C)$.
]

Таким же образом, как $Sigma_n^"(fn)"$-формы и $Pi_n^"(fn)"$-формы, определяются
_$Sigma_n^"(fn)" [cal(C)]$-формы_ и _$Pi_n^"(fn)"
[cal(C)]$-формы_ (с заменой в определении рекурсивных отношений на отношения,
рекурсивные в $cal(C)$).

#definition[
  $Sigma_n^"(fn)" [cal(C)]$#notation(
    $Sigma_n^"(fn)" [cal(C)], Pi_n^"(fn)" [cal(C)]$,
  )~— класс всех отношений, выразимых в $Sigma_n^"(fn)" [cal(C)]$-форме.

  $Pi_n^"(fn)" [cal(C)]$~— класс всех отношений, выразимых в $Pi_n^"(fn)"
  [cal(C)]$-форме.
]

Заметим, что классы отношений $Sigma_n^"(fn)" [cal(C)]$ и $Pi_n^"(fn)"
[cal(C)]$ могут быть несчетными. В частности, если $cal(C) = cal(N)$, то
$cal(A) in Sigma_0^"(fn)" [cal(C)] <=> cal(A)$~— открыто-замкнутый класс
(упр.~@ex:clopen-classes-sigma-zero). Несмотря на эту возможную несчетность,
можно доказать следующую обобщенную теорему о нормальной форме и нумерации.

#definition[
  $
    T_n^*#notation($T_n^*$) = {tuple(g, f, x_1, ..., x_n) | & T'_(2, n-1)(g(0),
        lambda x [g(x + 1)], f, x_1, ... \
        & ..., x_n)} = {tuple(g, f, x_1, ..., x_n) | T_(2, n-1)(g(0), \
        & tau(lambda x [g(x + 1)]), tau(f), x_1, ..., x_n)}.
  $
]

#theorem(
  title: [теорема о нормальной форме и нумерации#idx(
      "Арифметическая",
      "иерархия",
      "теоремы о нормальной форме и перечислимости",
      en: "normal form and enumeration theorems",
    )],
)[
  Для любого $n > 0$: класс $cal(A) in Sigma_n^"(fn)" [cal(C)] <=>$ для
  некоторого множества $A$ из $cal(C)$ и некоторой всюду определенной функции
  $g$, рекурсивной относительно $A$, имеем $cal(A) = {f | (exists x_1)(forall
      x_2) ... T_n^*(g, f, x_1, ..., x_n)}$ (причем перед $T_n^*$ стоит знак
  отрицания, если $n$ четно). Аналогичное предложение имеет место для
  $Pi_n^"(fn)" [cal(C)]$.
] <th:generalized-normal-form-enumeration>

#proof[
  $arrow.l.double$. Очевидно, так как $[$функция $g$ рекурсивна относительно $A$
  и $A in cal(C)]$ влечет за собой, что отношение ${tuple(f, x_1, ..., x_n) |
    T_n^*(g, f, x_1, ..., x_n)}$ рекурсивно относительно $cal(C)$.

  $=>$. Пусть $cal(A) in Sigma_n^"(fn)" [cal(C)]$.

  Рассмотрим случай (i) число $n$ нечетно. Тогда для некоторого множества $A$ из
  класса $cal(C)$
  $
    cal(A) = {f | (exists x_1)(forall x_2) ... (exists x_n) R(f, x_1, ...,
        x_n)},
  $
  при этом отношение $R$ рекурсивно относительно $A$. В силу релятивизованного
  варианта теоремы~@th:function-sigma-one-domains отношение ${tuple(
      f, x_1,
      ..., x_(n-1)
    ) | (exists x_n) R(f, x_1, ..., x_n)}$ является областью определения функции
  $psi$ одной функциональной переменной и $n - 1$ числовых переменных, причем
  $psi = lambda f x_1 ... x_(n-1) [phi_z^(A, tau(f)) (x_1,
      ..., x_(n-1))]$ для некоторого $z$. Следовательно,
  $
    (exists x_n) R(f, x_1, ..., x_n) <=> (exists x_n) T_(2, n-1)(z, A, tau(f),
      x_1, ..., x_n).
  $
  #source(458)Выберем $z'$ так, чтобы $T_(2, n-1)(z, A, tau(f), x_1, ..., x_n)
  <=> T_(2, n-1)(z', tau(c_A), tau(f), x_1, ..., x_n)$. Тогда $cal(A) = {f |
    (exists x_1)(forall x_2) ... (exists x_n) T'_(2, n-1)(z', c_A, f, x_1, ...,
      x_n)}$. Существует такая функция $g$, что $g(0) = z'$ и что $lambda x [g(x
      + 1)] = c_A$. Функция $g$ рекурсивна относительно $A$ и
  $
    cal(A) = {f | (exists x_1)(forall x_2) ... (exists x_n) T_n^*(g, f, x_1,
        ..., x_n)}.
  $

  Рассмотрим случай (ii) число $n$ четно. Достаточно для $overline(cal(A))$
  провести построение, как в случае (i), и затем взять отрицание.

  Аналогично проводится доказательство для $Pi_n^"(fn)" [cal(C)]$.
]

Таким образом, функции, рекурсивные относительно множеств из $cal(C)$, можно
рассматривать как гёделевы номера для любого уровня в $[cal(C)]$-арифметической
иерархии. В частности, когда $g$ пробегает класс общерекурсивных функций, то
получим для данного $n$ все классы из $Sigma_n^"(fn)"$ и все классы из
$Pi_n^"(fn)"$.

С помощью простой диагонализации получим обобщенную теорему об иерархии.

#theorem[
  Для любого $n > 0$ существует такой класс $cal(A)$, что для любого непустого
  класса $cal(C)$
  $ cal(A) in (Sigma_n^"(fn)" [cal(C)] - Pi_n^"(fn)" [cal(C)]). $
] <th:generalized-hierarchy>

#proof[
  Возьмем $cal(A) = {f | (exists x_1)(forall x_2) ... T_n^*(f, f, x_1, ...,
      x_n)}$. Тогда $cal(A) in Sigma_n^"(fn)" subset Sigma_n^"(fn)" [cal(C)]$.
  Допустим, что $cal(A) in Pi_n^"(fn)" [cal(C)]$. Тогда
  $ cal(A) = {f | (forall x_1)(exists x_2) ... T_n^*(g, f, x_1, ..., x_n)} $
  для некоторой функции $g$, рекурсивной относительно $cal(C)$. Следовательно,
  $
    overline(cal(A)) = {f | (exists x_1)(forall x_2) ... T_n^*(g, f, x_1, ...,
        x_n)}.
  $
  Имеем $g in cal(A) <=> (exists x_1)(forall x_2) ... T_n^*(g, g, x_1, ...,
    x_n) <=> g in overline(cal(A))$. Получили противоречие.
]

Мы показали в теореме~@th:function-hierarchy, что на любом уровне арифметической
иерархии есть открыто-замкнутые классы, т.~е. классы из уровня $Sigma_0^(**)$ в
классической иерархии Бореля. Теорема~@th:generalized-hierarchy показывает, что,
с другой стороны, на всех уровнях имеются классы, находящиеся на одинаковых
уровнях в арифметической и классической иерархиях#idx(
  "Борелевские",
  "множества",
  "классическая иерархия",
  en: "classical hierarchy of",
  range: "end",
)#idx(
  "Теоремы",
  "об",
  "иерархии",
  "обобщенные",
  en: "generalized",
  range: "end",
)#idx(
  "Арифметическая",
  "иерархия",
  "классов множеств",
  "функций",
  en: "of sets of functions",
  range: "end",
).
