#import "main-defs.typ": (
  chapter, idx, marker, notation, one, roman, section, source, tuple, zero,
)
#import "statements.typ": corollary, definition, lemma, proof, run-in, theorem
#chapter[Решетка рекурсивно перечислимых множеств] <ch:lattice-re-sets>

#section[Решетки множеств] <sec:lattices-of-sets>

#source(286)#idx(
  "Решетка",
  "множества как",
  en: "sets as a",
  range: "start",
)В предыдущих главах для изучения рекурсивно инвариантных свойств множеств
натуральных чисел мы использовали понятия _сводимости_#idx(
  "Сводимость",
  en: "reducibility",
) и _степени неразрешимости_#idx(
  "Степени",
  "неразрешимости",
  en: "degrees of unsolvability",
). Рассмотрение совокупности рекурсивно перечислимых множеств как _решетки_
представляет собой иной, несколько отличный от предыдущих подход к их изучению.
Мы описываем здесь этот подход. Впервые он изучался Деккером#idx(
  "Деккер",
  en: "Dekker J.",
) и Майхиллом#idx("Майхилл", en: "Myhill J.") (см. Майхилл~@bib:Myhill1956).

#definition[
  _Решеткой_#idx("Решетка", en: "lattice") называется частичное упорядочение,
  при котором любые два элемента имеют наименьшую верхнюю и наибольшую нижнюю
  грани#footnote[
    _Частичным упорядочением_#idx(
      "Частичное",
      "упорядочение",
      en: "partial ordering",
    ) называется здесь такое отношение $R$ (на некотором множестве), что для
    любых $a$, $b$ и $c$ (из этого множества)
    #enum(numbering: "(i)")[
      $[tuple(a, b) in R \& tuple(b, c) in R] => tuple(a, c) in R$,
    ][
      $[tuple(a, b) in R \& tuple(b, a) in R] <=> a = b$.
    ]
    Условимся читать „$tuple(a, b) in R$“ как „$a$ меньше или равно $b$“.
    Элемент $c$ есть _наименьшая верхняя грань_ для $a$ и $b$, если (i)
    $tuple(a, c) in R$ и $tuple(b, c) in R$ и (ii) для любого $d$ (из данного
    множества) $[tuple(a, d) in R \& tuple(b, d) in R] => tuple(c, d) in R$.
    Аналогично определяется _наибольшая нижняя грань_. Для более подробного
    рассмотрения решеток см. Биркгоф#idx(
      "Биркгоф",
      en: "Birkhoff G.",
    )~@bib:Birkhoff1940.
  ].
]

Объекты, которые участвуют в этом отношении, будем называть _элементами_
решетки. Мы используем для них буквы $a, b, ...$. Если $a$ меньше или равно $b$
в решетке, мы пишем „$a <= b$“\; $a < b$ обозначает $[a <= b \& a != b]$. Если
$a$~— элемент решетки $cal(L)$, мы пишем „$a in cal(L)$“.

#definition[
  Если $a$ и $b$~— элементы решетки $cal(L)$, то $a union b$ обозначает
  наименьшую верхнюю грань („сумму“ или „объединение“) элементов $a$ и $b$\;
  $a inter b$ обозначает наибольшую нижнюю грань („произведение“ или
  „пересечение“#idx("Пересечение", en: "meet")) элементов $a$ и $b$.#notation(
    [$union$, $inter$, $overline(a)$ (решетка)],
    key: "lattice-operations",
    range: "start",
  )
]

Совокупность всех подмножеств любого фиксированного множества образует решетку
относительно включения множеств ($subset$) #source(287)с суммами и
произведениями, совпадающими с обычными объединениями и пересечениями
соответственно. В частности, $cal(N) = {A | A subset N}$ $(= 2^N)$ есть
структура относительно $subset$. Отметим, что во всякой решетке
$ a <= b <=> b = a union b <=> a = a inter b. $
Таким образом, частичное упорядочение $<=$ может быть определено с помощью
операций $union$ и $inter$. В действительности определение решетки можно
сформулировать с помощью лишь операций $union$ и $inter$, накладывая на $union$
и $inter$ подходящие аксиоматические ограничения (см. упр.~@ex:lattice-axioms).

#definition[
  Пусть $cal(L)$~— решетка. $cal(M)$ называется _подрешеткой_#idx(
    "Решетка",
    "подрешетка",
    en: "sublattice",
  ) решетки $cal(L)$, если
  #enum(numbering: "(i)")[
    $cal(M)$ есть решетка;
  ][
    (частичное упорядочение решетки) $cal(M)$ содержится в (частичном
    упорядочении) $cal(L)$\;
  ][
    $cal(M)$ замкнуто относительно операций $union$ и $inter$ в $cal(L)$ ((iii)
    не следует из (i) и (ii), см. упр.~@ex:subset-not-sublattice).
  ]
]

#run-in[Примеры] Пусть $cal(E)$~— частичное упорядочение рекурсивно перечислимых
множеств с помощью включения, $cal(R)$~— частичное упорядочение рекурсивных
множеств с помощью включения.#notation($cal(E), cal(R)$) Согласно
теоремам~@th:re-closure-uniform и~@th:recursive-closure, $cal(R)$ и $cal(E)$
являются подрешетками решетки $cal(N)$, а $cal(R)$ есть подрешетка решетки
$cal(E)$.

#definition(word: "Определения")[
  Решетка называется _дистрибутивной_#idx(
    "Решетка",
    "дистрибутивная",
    en: "distributive",
  ), если выполняются тождества
  $
    a union (b inter c) & = (a union b) inter (a union c), \
    a inter (b union c) & = (a inter b) union (a inter c).
  $
]

Ясно, что всякая подрешетка дистрибутивной решетки дистрибутивна. Дальше мы
будем иметь дело только с дистрибутивными решетками.

Если решетка содержит минимальный элемент, то этот (обязательно единственный)
элемент называется ее _нулевым элементом_#idx(
  "Решетка",
  "нулевой элемент",
  en: "zero element of",
). Если решетка содержит максимальный элемент, то этот (обязательно
единственный) элемент называется _единичным_#idx(
  "Решетка",
  "единичный элемент",
  en: "unit element of",
). Мы иногда обозначаем нулевой элемент решетки через $zero$, а единичный~—
через $one$. (Отметим, что если $cal(M)$ есть подрешетка решетки $cal(L)$, то
нулевой и единичный элементы решетки $cal(M)$ могут не совпадать с нулевым и
единичным элементами решетки $cal(L)$.)

Пусть $a$ и $b$~— элементы решетки, содержащей нулевой элемент ($zero$)\; $a$ и
$b$ называются _дизъюнктными_#idx(
  "Дизъюнктные элементы",
  en: "disjoint elements",
), если $a inter b = zero$.

Пусть $a$ и $b$~— элементы решетки, содержащей нулевой элемент ($zero$) и
единичный элемент ($one$). Элемент $b$ называется _дополнением_ элемента $a$,
если $a inter b = zero$ и $a union b = one$.

#source(288)Если решетка $cal(L)$ содержит нулевой и единичный элементы и любой
элемент $cal(L)$ имеет дополнение, то $cal(L)$ называется _решеткой с
дополнениями_#idx("Решетка", "с дополнениями", en: "complemented").

Дистрибутивная решетка с дополнениями называется _булевой алгеброй_#idx(
  "Булева",
  "алгебра",
  en: "boolean algebra",
). В булевой алгебре каждый элемент $a$ имеет одно и только одно дополнение,
которое обозначается через $overline(a)$ (см.
упр.~@ex:unique-complement).#notation(
  [$union$, $inter$, $overline(a)$ (решетка)],
  key: "lattice-operations",
  range: "end",
)

#run-in[Примеры] Решетка $cal(N)$ является булевой алгеброй. Решетка $cal(E)$
содержит нулевой и единичный элементы, но не является решеткой с дополнениями.
$cal(R)$ является булевой алгеброй.

_Теорема Стоуна о представлении_#idx(
  "Стоуна теорема о представлении",
  en: "Stone representation theorem",
) (упр.~@ex:stone-representation) утверждает, что для всякой булевой алгебры
$cal(B)$ существует такое множество $Sigma$, что $cal(B)$ изоморфна некоторой
подрешетке решетки всех подмножеств множества $Sigma$. Из теоремы Стоуна
следует, что всякая булева алгебра (а потому и всякая подрешетка любой булевой
алгебры) должна удовлетворять всем тождествам (содержащим символы операций
$union$, $inter$ и $macron$), верным в решетках множеств (см.
упр.~@ex:boolean-identities).

#definition(word: "Определения")[
  Пусть $cal(L)$~— решетка, $cal(I)$~— непустое множество элементов решетки
  $cal(L)$. Будем говорить, что $cal(I)$~— _идеал_#idx(
    "Идеал решетки",
    en: "ideal in a lattice",
    see-also: "Дуальный идеал решетки",
  ) в $cal(L)$, если
  #enum(numbering: "(i)")[
    $[c_1 in cal(I) \& c_2 in cal(I)] => c_1 union c_2 in cal(I)$\;
  ][
    $[a in cal(L) \& c in cal(I)] => a inter c in cal(I)$.
  ]

  Пусть $cal(L)$~— решетка, $cal(D)$~— непустое множество элементов из $cal(L)$.
  Назовем $cal(D)$ _дуальным идеалом_#idx(
    "Дуальный",
    "идеал решетки",
    en: "dual ideal in lattice",
  )#idx(
    "Решетка",
    "дуальный идеал",
    en: "dual ideal",
    see: "Дуальный идеал решетки",
  ) (или _фильтром_#idx("Фильтр", en: "filter")), если
  #enum(numbering: "(i)")[
    $[c_1 in cal(D) \& c_2 in cal(D)] => c_1 inter c_2 in cal(D)$\;
  ][
    $[a in cal(L) \& c in cal(D)] => a union c in cal(D)$.
  ]
]

Всякий идеал, как и дуальный идеал решетки $cal(L)$, очевидно, является ее
подрешеткой.

#run-in[Примеры] Семейство $cal(F)$ всех конечных множеств образует идеал в
$cal(N)$.

Семейство $cal(S)$ всех простых множеств#idx(
  "Простое",
  "множество",
  en: "simple set",
) и множеств с конечными дополнениями образует дуальный идеал в $cal(E)$,
согласно упр.~@ex:simple-dual-ideal.

Для дальнейшего обсуждения основной является следующая

#theorem[
  #roman[(a)] Пусть $cal(L)$~— дистрибутивная решетка, и пусть $cal(I)$~— идеал
  в $cal(L)$. Положим $a approx_cal(I) b$, если $(exists c_1) (exists
    c_2) [c_1 in cal(I) \& c_2 in cal(I) \& [a union c_1 = b union c_2]]$. Тогда
  $approx_cal(I)$ является отношением эквивалентности на множестве элементов
  решетки $cal(L)$. Операции $union$ и $inter$ корректно определены на классах
  эквивалентности, и классы эквивалентности образуют дистрибутивную решетку
  относительно $union$ и $inter$. Будем называть эту решетку классов
  эквивалентности #roman[факторрешеткой]#idx(
    "Факторрешетка",
    en: "quotient lattice",
    range: "start",
  )#idx(
    "Решетка",
    "факторрешетка",
    en: "quotient",
    range: "start",
  ) $cal(L) slash cal(I)$.#notation($cal(L) slash cal(I)$) Сам идеал $cal(I)$
  является классом эквивалентности и служит нулевым элементом в
  $cal(L) slash cal(I)$.

  #roman[(b)] Пусть $cal(L)$~— дистрибутивная решетка и $cal(D)$~— дуальный
  идеал в $cal(L)$. Положим $a approx_cal(D) b$, если $(exists c_1) (exists
    c_2) [c_1 in cal(D) \& c_2 in cal(D) \& [a inter c_1 = b inter c_2]]$. Тогда
  $approx_cal(D)$ есть отношение эквивалентности #source(289)на $cal(L)$.
  Операции $union$ и $inter$ корректно определены на его классах
  эквивалентности, и классы эквивалентности образуют дистрибутивную решетку
  относительно $union$ и $inter$. Мы называем эту решетку классов
  эквивалентности #roman[факторрешеткой] $cal(L) slash^* cal(D)$#notation(
    $cal(L) slash^* cal(D)$,
  ) (где \* означает, что использовался дуальный идеал#idx(
    "Дуальный",
    "идеал решетки",
    en: "dual ideal in lattice",
  )). Сам $cal(D)$ является классом эквивалентности и служит единичным элементом
  в $cal(L) slash^* cal(D)$.

  #roman[(c)] Пусть $cal(L)$~— булева алгебра. Если $cal(I)$~— идеал в $cal(L)$,
  то $cal(L) slash cal(I)$ есть булева алгебра. Если $cal(D)$~— дуальный идеал в
  $cal(L)$, то $cal(L) slash^* cal(D)$ есть булева алгебра. Пусть $cal(I)$~—
  некоторое множество элементов решетки $cal(L)$, и пусть
  $cal(D) = {a | overline(a) in cal(I)}$. Тогда $cal(I)$ есть идеал в том и
  только том случае, когда $cal(D)$~— дуальный идеал\; если $cal(I)$ есть идеал,
  то $cal(L) slash cal(I)$ и $cal(L) slash^* cal(D)$ совпадают.

  #roman[(d)] Пусть $cal(L)$~— дистрибутивная решетка, $cal(I)$~— идеал в
  $cal(L)$, $cal(M)$~— подрешетка в $cal(L)$. Тогда классы эквивалентности
  относительно $approx_cal(I)$, каждый из которых содержит по крайней мере по
  одному элементу из $cal(M)$, образуют подрешетку в $cal(L) slash cal(I)$. Мы
  обозначаем эту подрешетку через „$cal(M) slash cal(I)$ в $cal(L)$“. (Заметим,
  что $cal(I)$ не обязательно содержится в $cal(M)$.) Подобным же образом
  вводится обозначение „$cal(M) slash^* cal(D)$ в $cal(L)$“, где $cal(D)$~—
  дуальный идеал в $cal(L)$#footnote[
    Иногда при использовании (d) решетка $cal(L)$ не будет явно упоминаться. Что
    она собой представляет, всегда будет ясно из контекста или из предыдущего
    обсуждения.
  ].
] <th:quotient-lattices>

#proof[
  (a) Легко проверяется, что $approx_cal(I)$ есть отношение эквивалентности
  (упр.~@ex:ideal-equivalence).

  Пусть $a_1 approx_cal(I) a_2$ и $b_1 approx_cal(I) b_2$. Тогда
  $a_1 union c_1 = a_2 union c_2$ и $b_1 union c_3 = b_2 union c_4$, где $c_1$,
  $c_2$, $c_3$ и $c_4$ принадлежат $cal(I)$. Соединяя эти равенства с помощью
  $union$, получаем
  $
    (a_1 union c_1) union (b_1 union c_3) = (a_2 union c_2) union
    (b_2 union c_4),
  $
  а потому $(a_1 union b_1) union (c_1 union c_3) = (a_2 union b_2) union
  (c_2 union c_4)$. Поэтому $a_1 union b_1 approx_cal(I) a_2 union b_2$, так как
  $c_1 union c_3$, $c_2 union c_4 in cal(I)$. Аналогично, объединяя наши
  равенства с помощью $inter$, получим
  $
    (a_1 union c_1) inter (b_1 union c_3) = (a_2 union c_2) inter
    (b_2 union c_4),
  $
  откуда в силу дистрибутивности
  $
    (a_1 inter b_1) union (a_1 inter c_3) union (c_1 inter b_1) union
    (c_1 inter c_3) = \
    = (a_2 inter b_2) union (a_2 inter c_4) union (c_2 inter b_2) union
    (c_2 inter c_4).
  $
  Так как $a_1 inter c_3$, $c_1 inter b_1$, $c_1 inter c_3$, $a_2 inter c_4$,
  $c_2 inter b_2$ и $c_2 inter c_4$ все должны принадлежать $cal(I)$, а значит,
  и $(a_1 inter c_3) union (c_1 inter b_1) union (c_1 inter c_3)$ и
  $(a_2 inter c_4) union (c_2 inter b_2) union (c_2 inter c_4)$ оба должны
  содержаться в $cal(I)$, получаем, что $a_1 inter b_1 approx_cal(I) a_2 inter
  b_2$.

  Итак, $union$ и $inter$ корректно определяют операции на классах
  эквивалентности. Отсюда следует, что любое тождество, верное для #source(
    290,
  )операций в $cal(L)$, должно выполняться и для операций на классах
  эквивалентности. Поэтому (в силу упр.~@ex:lattice-axioms)
  $cal(L) slash cal(I)$ является дистрибутивной решеткой. В
  упр.~@ex:ideal-zero-class мы показываем, что $cal(I)$ образует класс
  эквивалентности, который является нулевым элементом в $cal(L) slash cal(I)$.

  (b) Доказательство аналогично доказательству пункта (a).

  (c) Чтобы показать, что $cal(L) slash cal(I)$ есть булева алгебра, достаточно
  убедиться, что операция взятия дополнения в $cal(L)$ корректно переносится на
  классы эквивалентности. Пусть $a union c_1 = b union c_2$, где
  $c_1, c_2 in cal(I)$. Тогда $overline(a union c_1) = overline(b union c_2)$.
  Поэтому (упр.~@ex:boolean-identities)
  $overline(a) inter overline(c)_1 = overline(b)
  inter overline(c)_2$. Значит,
  $
    (overline(a) inter overline(c)_1) union (overline(a) inter c_1) union
    (overline(b) inter c_2) = (overline(b) inter overline(c)_2) union
    (overline(b) inter c_2) union (overline(a) inter c_1).
  $
  Применяя упр.~@ex:boolean-identities, получим
  $
    overline(a) union (overline(b) inter c_2) = overline(b) union
    (overline(a) inter c_1).
  $
  Отсюда следует, что $overline(a) approx_cal(I) overline(b)$, так как
  $overline(b) inter c_2$, $overline(a) inter c_1 in cal(I)$.

  Аналогично проходит доказательство для $cal(L) slash^* cal(D)$, когда
  $cal(D)$~— дуальный идеал.

  Пусть $cal(I)$~— множество элементов $cal(L)$ и $cal(D) = {a | overline(a)
    in cal(I)}$. Тогда $c in cal(I) <=> overline(c) in cal(D)$. Возьмем $c_1$ и
  $c_2$ из $cal(I)$\; тогда $c_1 union c_2 in cal(I) <=> overline(
    c_1 union
    c_2
  ) in cal(D) <=> overline(c)_1 inter overline(c)_2 in cal(D)$. Возьмем теперь
  $c in cal(I)$ и $a in cal(L)$\; тогда $c inter a in cal(I) <=>
  overline(c inter a) in cal(D) <=> overline(c) union overline(a) in cal(D)$.
  Поэтому, если $cal(D)$~— дуальный идеал, то $cal(I)$~— идеал. Сходное
  рассуждение показывает, что $cal(D)$~— дуальный идеал, если $cal(I)$~— идеал.
  Предположим теперь, что $cal(I)$~— идеал. Тогда $a approx_cal(I) b
  <=> overline(a) approx_cal(I) overline(b)$ (так как операция взятия дополнения
  корректно определена на классах эквивалентности) $<=>
  overline(a) union c_1 = overline(b) union c_2 <=> overline(
    a inter
    overline(c)_1
  ) = overline(b inter overline(c)_2) <=> a inter overline(c)_1 =
  b inter overline(c)_2$ (так как дополнения единственны в $cal(L)$) $<=> a
  approx_cal(D) b$. Поэтому отношения $approx_cal(I)$ и $approx_cal(D)$
  совпадают, а значит, совпадают и $cal(L) slash cal(I)$ и $cal(L) slash^*
  cal(D)$.

  (d) Это непосредственно следует из (a), определения подрешетки и
  упр.~@ex:lattice-axioms.
]

Утверждение, обратное к (c), и частичное обращение (a) приведены в
упр.~@ex:homomorphism-kernel.

Мы уже упоминали следующие решетки, идеалы и дуальные идеалы:

/ $cal(N)$: решетка всех множеств натуральных чисел,
/ $cal(E)$: решетка всех рекурсивно перечислимых множеств#idx(
    "Рекурсивно",
    "перечислимое",
    "множество",
    "решетка",
    en: "lattice of",
    range: "start",
  ),
/ $cal(R)$: решетка всех рекурсивных множеств,
/ $cal(F)$#notation([$cal(F)$ (конечные множества)]): идеал (в $cal(N)$)
  конечных множеств,
/ $cal(S)$#notation($cal(S)$): дуальный идеал (в $cal(E)$) простых множеств#idx(
    "Простое",
    "множество",
    en: "simple set",
  ) и коконечных множеств.

#source(291)В силу упр.~@ex:hypersimple-dual-ideal мы имеем также, что

/ $cal(K)$#notation($cal(K)$): дуальный идеал (в $cal(E)$) коконечных и
  гиперпростых#idx("Гиперпростое множество", en: "hypersimple set") множеств.
  (Коконечные и гипергиперпростые#idx(
    "Гипергиперпростое множество",
    en: "hyperhypersimple set",
  ) множества также образуют дуальный идеал в $cal(E)$\; см.
  упр.~@ex:hyperhypersimple-dual-ideal.)

Теорема~@th:quotient-lattices позволяет нам строить различные факторрешетки:
$cal(N) slash cal(F)$, $cal(E) slash cal(F)$, $cal(R) slash cal(F)$,
$cal(E) slash^* cal(S)$, $cal(E) slash^* cal(K)$, $cal(R) slash^* cal(S)$ и
$cal(R) slash^* cal(K)$. (Упражнение~@ex:sublattice-ideal показывает, что
$cal(R) slash^* cal(K) = cal(R) slash^* cal(S) = cal(R) slash cal(F)$.) Любой
элемент решетки $cal(N) slash cal(F)$, содержащий рекурсивно перечислимое
множество, состоит только из рекурсивно перечислимых множеств. Мы называем такие
элементы _рекурсивно перечислимыми_. Аналогично определятся _рекурсивные_
элементы в $cal(N) slash cal(F)$. Решетка $cal(R) slash cal(F)$ является
подрешеткой в $cal(E) slash cal(F)$, а $cal(E) slash cal(F)$~— подрешеткой в
$cal(N) slash cal(F)$. В этой главе главным образом рассматривается
факторрешетка $cal(E) slash cal(F)$#idx(
  "Факторрешетка",
  en: "quotient lattice",
  range: "end",
)#idx(
  "Решетка",
  "факторрешетка",
  en: "quotient",
  range: "end",
).

В каком смысле решетка $cal(E) slash cal(F)$ инвариантна? Любые два множества
натуральных чисел, $!= emptyset$ и $!= N$, принадлежащие одному и тому же
элементу из $cal(E) slash cal(F)$, m-эквивалентны. С другой стороны, рекурсивно
изоморфные множества могут попасть в различные элементы решетки
$cal(E) slash cal(F)$ (например, множества четных и нечетных чисел). Так что
сами по себе элементы из $cal(E) slash cal(F)$ (отличные от $zero$ и $one$) так
же, как и элементы из $cal(E)$ (отличные от $emptyset$ и $N$), не являются
рекурсивно инвариантными объектами. Тем не менее в некотором важном отношении
решетка $cal(E) slash cal(F)$ рекурсивно инвариантна. Мы определим сначала
понятие _теоретико-решеточного свойства_.

#definition[
  Свойство, т.~е. некоторое множество элементов решетки $cal(L)$, называется
  _теоретико-решеточным в $cal(L)$_#idx(
    "Теоретико-решеточное",
    "свойство",
    en: "lattice-theoretic property",
    range: "start",
  ), если оно инвариантно относительно всех автоморфизмов решетки $cal(L)$.
  (Мотивировка: свойство должно называться теоретико-решеточным в $cal(L)$, если
  оно „определимо“#idx(
    "Определимость",
    ", автоморфизмы",
    en: "definability, and automorphisms",
  ) в терминах решеточной структуры в $cal(L)$.)#footnote[
    $f$ называется _автоморфизмом_#idx(
      "Решетка",
      "автоморфизм",
      en: "automorphism of",
      note: true,
    ) решетки $cal(L)$, если $f$~— такое взаимно однозначное отображение
    $cal(L)$ на $cal(L)$, что $f(a union b) = f(a) union f(b)$ и $f(a inter b)
    = f(a) inter f(b)$ для всех $a, b in cal(L)$.
  ]
]

#definition[
  Пусть решетка $cal(L)$ содержит подрешетку $cal(M)$. Свойство элементов из
  $cal(L)$ называется _теоретико-решеточным в $cal(L)$ по отношению к
  $cal(M)$_, если оно инвариантно относительно всех автоморфизмов решетки
  $cal(L)$, отображающих $cal(M)$ на себя. (Мотивировка: свойство должно
  называться теоретико-решеточным в $cal(L)$ по отношению к $cal(M)$, если оно
  „определимо“ в терминах решеточной структуры на $cal(L)$ и принадлежности к
  $cal(M)$.)
]

Мы сокращаем выражение „теоретико-решеточное в $cal(N)$ по отношению к $cal(E)$“
до „теоретико-решеточное по отношению к $cal(E)$“. Так как каждый автоморфизм
решетки $cal(E)$ продолжается до автоморфизма решетки $cal(N)$ (оба определяются
индуцированным автоморфизмом на $cal(F)$), свойство рекурсивно перечислимых
множеств#idx(
  "Решетка",
  "множества как",
  en: "sets as a",
  range: "end",
) теоретико-#source(292)решеточно по отношению к $cal(E)$ тогда и только тогда,
когда оно теоретико-решеточно в $cal(E)$.

#run-in[Примеры] Свойство _конечности_#idx(
  "Конечные множества",
  en: "finite sets",
) теоретико-решеточно в $cal(E)$. Свойство _иммунности_#idx(
  "Иммунное множество",
  en: "immune set",
) теоретико-решеточно по отношению к $cal(E)$.

#definition[
  Свойство рекурсивно перечислимых множеств называется _теоретико-решеточным в
  $cal(E) slash cal(F)$_, если оно есть множество-сумма для свойства (т.~е.
  множества) элементов $cal(E) slash
  cal(F)$, теоретико-решеточного в $cal(E) slash cal(F)$#footnote[
    Назовем свойство множеств _элементарно теоретико-решеточным_#idx(
      "Теоретико-решеточное",
      "свойство",
      "элементарно",
      en: "elementary",
    ) в $cal(E) slash cal(F)$, если существует такая формула логики предикатов с
    единственным предикатным символом $<=$ и единственной свободной индивидной
    переменной, что если ограничить кванторы областью $cal(E) slash
    cal(F)$, а $<=$ интерпретировать как имеющееся в решетке $cal(E) slash
    cal(F)$ упорядочение, то множества с рассматриваемым свойством суть в
    точности те множества, которые принадлежат элементам $cal(E) slash
    cal(F)$, удовлетворяющим этой формуле. Например, формула $(forall b) [a <=
      b]$ определяет элементарно теоретико-решеточное свойство _конечности_.

    _Теория первого порядка_#idx(
      "Теория",
      "первого",
      "порядка",
      en: "first-order",
      note: true,
    ) решетки $cal(E) slash cal(F)$ состоит из всех формул, содержащих только
    предикатный символ $<=$, без свободных переменных, истинных в $cal(E)
    slash cal(F)$. Не известно, будет ли эта теория разрешимой или хотя бы
    аксиоматизируемой. С помощью разрешающей процедуры для этой теории можно
    было бы прямо получить теоремы~@th:friedberg-splitting,
    @th:maximal-set-exists и~@th:no-maximal-superset (ниже) и решить некоторые
    открытые проблемы. Пусть $cal(K)$~— дуальный идеал (в $cal(E)$) коконечных и
    гипергиперпростых#idx(
      "Гипергиперпростое множество",
      en: "hyperhypersimple set",
      note: true,
    ) множеств. Лахлан#idx(
      "Лахлан",
      en: "Lachlan A.",
      note: true,
    ) показал, что теории первого порядка решеток $cal(K)$, $cal(R)$,
    $cal(K) slash cal(F)$ и $cal(R) slash cal(F)$ разрешимы. Он доказал также,
    что проблема разрешения теории первого порядка $cal(E)$ сводится к проблеме
    разрешения теории первого порядка $cal(E) slash cal(F)$.
  ].
]

#run-in[Примеры] _Рекурсивность_~— теоретико-решеточное свойство в $cal(E)
slash cal(F)$, так как $A$ рекурсивно тогда и только тогда, когда $A$
принадлежит элементу из $cal(E) slash cal(F)$, обладающему дополнением.

_Простота_#idx(
  "Простое",
  "множество",
  en: "simple set",
)~— теоретико-решеточное свойство в $cal(E) slash cal(F)$, потому что множество
$A$ просто тогда и только тогда, когда оно принадлежит неединичному элементу
факторрешетки $cal(E) slash cal(F)$, для которого нет ненулевого элемента,
дизъюнктного к нему.

Отношения на множествах также могут быть теоретико-решеточными (в очевидном
смысле: инвариантность в $cal(L)^n$ относительно автоморфизмов решетки
$cal(L)$). Например, рекурсивная неотделимость и сильная неотделимость
(упр.~@ex:strongly-inseparable)~— теоретико-решеточные свойства в $cal(E)
slash cal(F)$.

#theorem[
  Теоретико-решеточные в $cal(E) slash cal(F)$ свойства рекурсивно инвариантны.
] <th:lattice-theoretic-invariant>

#proof[
  Каждое рекурсивное преобразование $f$ индуцирует автоморфизм решетки $cal(E)$,
  именно отображение, переводящее $A$ в $f(A)$. Этот автоморфизм отображает
  $cal(F)$ на $cal(F)$ и потому индуцирует автоморфизм факторрешетки
  $cal(E) slash cal(F)$. Поэтому свойство, инвариантное относительно всех
  автоморфизмов послед#source(293)ней, должно быть инвариантным относительно
  всех рекурсивных преобразований.
]

Должно ли рекурсивно инвариантное свойство (рекурсивно перечислимых множеств),
корректно определенное на $cal(E) slash cal(F)$, быть теоретико-решеточным в
$cal(E) slash cal(F)$? Это обращение теоремы~@th:lattice-theoretic-invariant
представляет собой открытый вопрос. Вероятным кажется отрицательный ответ.
Креативность#idx(
  "Творческие множества",
  en: "creative sets",
), гиперпростота#idx(
  "Гиперпростое множество",
  en: "hypersimple set",
), m-сводимость#idx(
  "m-сводимость",
  en: "m-reducibility",
) (для множеств, отличных от $N$ и $emptyset$) и слабые сводимости#idx(
  "Сводимость",
  "слабая",
  en: "weak",
) служат примерами рекурсивно инвариантных#idx(
  "Рекурсивная",
  "инвариантность",
  en: "recursive invariance",
) свойств, корректно определенных на $cal(E) slash cal(F)$, однако не известно,
будут ли они теоретико-решеточными в $cal(E) slash cal(F)$. В оставшейся части
этой главы (и особенно в~§~@sec:almost-finiteness) мы будем изучать различные
связанные между собой рекурсивно инвариантные свойства, про некоторые из которых
известно, что они теоретико-решеточны в $cal(E) slash
cal(F)$#idx(
  "Теоретико-решеточное",
  "свойство",
  en: "lattice-theoretic property",
  range: "end",
)#footnote[
  Следующий вопрос связан с обращением теоремы~@th:lattice-theoretic-invariant.
  Обязано ли теоретико-решеточное в $cal(E)$ и корректно определенное на
  $cal(E) slash cal(F)$ свойство быть теоретико-решеточным в
  $cal(E) slash cal(F)$? Это в свою очередь связано с вопросом: всякий ли
  автоморфизм решетки $cal(E) slash cal(F)$ индуцируется некоторым рекурсивным
  преобразованием? Оба вопроса открыты\; утвердительный ответ на второй влечет
  за собой утвердительный ответ на первый.

  Легко показать, что верны следующие импликации
  (упр.~@ex:automorphism-induces): „теоретико-решеточное в
  $cal(E) slash cal(F)$“ $=>$ „корректно определенное на $cal(E) slash cal(F)$ и
  теоретико-решеточное в $cal(E)$“ $=>$ „корректно определенное на
  $cal(E) slash cal(F)$ и рекурсивно инвариантное“. Истинны ли обратные
  импликации~— открытый вопрос. Он связан с также открытым вопросом: всякий ли
  автоморфизм факторрешетки $cal(E) slash cal(F)$ индуцируется некоторым
  автоморфизмом решетки $cal(E)$? Упражнение~@ex:automorphism-not-isomorphism
  показывает, что рекурсивно инвариантное свойство не обязательно
  теоретико-решеточно в $cal(E)$.
].

Отметим, что решетка $cal(E) slash cal(F)$ обладает следующим свойством
однородности: для всякого ее ненулевого элемента $a$ множество ${b | b <= a}$
представляет собой подрешетку, изоморфную $cal(E) slash cal(F)$
(упр.~@ex:principal-sublattice).

Мы рассмотрим ниже некоторые вопросы о строении $cal(E) slash cal(F)$.

1\. Всякий ли элемент решетки $cal(E) slash cal(F)$, не имеющий дополнения,
является объединением дизъюнктных элементов без дополнений? Этот вопрос можно
сформулировать и более привычным образом: всякое ли рекурсивно перечислимое
нерекурсивное множество есть объединение двух непересекающихся рекурсивно
перечислимых нерекурсивных множеств? Решение этой проблемы дано
в~§~@sec:splitting. Принадлежит оно Фридбергу#idx(
  "Фридберг",
  en: "Friedberg R.",
).

2\. Плотно ли упорядочена $cal(E) slash cal(F)$#idx(
  "Плотно упорядоченное множество",
  en: "densely ordered",
)? То есть, если $a < b$, обязательно ли существует такое $c$, что $a < c$ и
$c < b$? Решетки $cal(N)$, $cal(E)$ и $cal(R)$, конечно, не плотно упорядочены.
Легко показать, что решетки $cal(N) slash cal(F)$ и $cal(R)
slash cal(F)$ упорядочены плотно. Следующие определение и теорема ставят вопрос
о плотности факторрешетки $cal(E) slash cal(F)$ в несколько иной форме.

#definition[
  Элемент решетки $cal(E) slash cal(F)$ называется _максимальным_, если он
  максимален среди неединичных элементов этой решетки. #source(294)\(Легко
  показать, что среди ненулевых элементов решетки $cal(E) slash cal(F)$ нет
  минимальных.)
]

#theorem(title: [Майхилл#idx("Майхилл", en: "Myhill J.")])[
  $cal(E) slash cal(F)$ плотно упорядочена в том и только том случае, когда
  $cal(E) slash cal(F)$ не имеет максимальных элементов.
] <th:dense-iff-no-maximal>

#proof[
  $=>$. Очевидно.

  $arrow.l.double$. Допустим, что $cal(E) slash cal(F)$ не плотно упорядочена.
  Тогда найдутся такие $a$ и $b$, что $a < b$, но ни для какого $c$ не выполнено
  $a < c$ и $c < b$ одновременно. Переходя к представителям, получим множества
  $A$ и $B$, такие, что $A in a$, $B in b$ и $A subset B union D$, где $D$
  конечно (см. упр.~@ex:quotient-order). Пусть $f$~— взаимно однозначная
  общерекурсивная функция с областью значений $B union D$ (что возможно, так как
  $b != 0$). Возьмем $A' = f^(-1) (A)$. Тогда класс эквивалентности множества
  $A'$ есть искомый максимальный элемент, что легко проверяется.
]

В~§~@sec:maximal-sets мы решим проблему плотности, показав, что в $cal(E)
slash cal(F)$ существует максимальный неединичный элемент. Эта конструкция
принадлежит Фридбергу#idx("Фридберг", en: "Friedberg R.").

3\. Всякий ли неединичный элемент решетки $cal(E) slash cal(F)$ содержится в
некотором максимальном элементе? В~§~@sec:subsets-of-maximal-sets мы дадим
отрицательный ответ на этот вопрос. Это построение принадлежит Мартину#idx(
  "Мартин",
  en: "Martin D.",
).

В~§~@sec:cohesive-sets мы рассматриваем некоторый идеал в $cal(N)$, именно
идеал, порожденный _сжатыми_#idx(
  "Сжатые",
  "множества",
  en: "cohesive sets",
) множествами, и изучаем некоторые свойства его членов. Сжатые множества „почти
конечны“ в том смысле, что они не могут быть расщеплены на меньшие бесконечные
части с помощью рекурсивно перечислимых множеств.

В~§~@sec:almost-finiteness рассматривается еще несколько других понятий
„_почти-конечности_“#idx(
  "Почти-конечность",
  en: "almost-finiteness",
), например гипергипериммунность, и обсуждаются некоторые открытые
проблемы.#idx(
  "Рекурсивно",
  "перечислимое",
  "множество",
  "решетка",
  en: "lattice of",
  range: "end",
)

#section[Разложение] <sec:splitting>

Следующая теорема отвечает на вопрос 1 из~§~@sec:lattices-of-sets.

#theorem(title: [Фридберг#idx(
    "Фридберг",
    en: "Friedberg R.",
  )~@bib:Friedberg1958b])[
  Пусть $A$~— произвольное рекурсивно перечислимое нерекурсивное множество.
  Тогда существуют такие множества $B_1$ и $B_2$, что
  #enum(numbering: "(i)")[
    $B_1 union B_2 = A$,
  ][
    $B_1 inter B_2 = emptyset$,
  ][
    $B_1$ и $B_2$ рекурсивно перечислимы, но не рекурсивны.
  ]
] <th:friedberg-splitting>

#proof[
  Пусть $f$~— взаимно однозначная общерекурсивная функция с областью значений
  $A$. Мы опишем процедуру перечисления $B_1$ и $B_2$. Обозначим через
  $B_1^((n))$ совокупность элементов множества $B_1$, перечисленных к концу
  $n$-го шага. Аналогично определим $B_2^((n))$.

  #source(295)#run-in[Этап 0] Отнесем $f(0)$ к $B_1$.

  #run-in[Этап $n + 1$] Выполним по $n$ шагов в перечислении каждого из множеств
  $W_0$, $W_1$, ..., $W_n$. Обозначим получившиеся множества через $W_0^((n))$,
  $W_1^((n))$, ..., $W_n^((n))$. Посмотрим, существует ли такой $x$, $x <= n$,
  что $f(n + 1) in W_x^((n))$ и или $B_1^((n)) inter W_x^((n))
  = emptyset$, или $B_2^((n)) inter W_x^((n)) = emptyset$. Если это так, возьмем
  наименьший такой $x$ и назовем его $x_n$. Если
  $ B_1^((n)) inter W_(x_n)^((n)) = emptyset, $
  отнесем $f(n + 1)$ к $B_1$. Если $B_1^((n)) inter W_(x_n)^((n)) !=
  emptyset$, отнесем $f(n + 1)$ к $B_2$. Если же такого $x$ нет, отнесем $f(n
    + 1)$ к $B_1$.

  Ясно, что множества $B_1$ и $B_2$ рекурсивно перечислимы, $B_1 union B_2 =
  A$ и $B_1 inter B_2 = emptyset$. Остается доказать, что ни $B_1$, ни $B_2$ не
  может быть рекурсивным.

  Предположим, что множество $B_1$ рекурсивно. Тогда $overline(B)_1$ рекурсивно
  перечислимо. Пусть $overline(B)_1 = B_2 union overline(A) =
  W_m$. Тогда $W_m inter B_1 = emptyset$ и $overline(A) subset W_m$. Заметим,
  что, когда $n$ пробегает натуральный ряд, $x_n$ принимает каждое значение
  самое большее дважды. Поэтому должно найтись такое $n_0$, что для всех $n >
  n_0$ имеем $x_n > m$ (если только $x_n$ существует). Тогда $n > n_0 => f(n +
    1) in.not W_m^((n))$ (в противном случае на этапе $n + 1$ пришлось бы
  отнести $f(n + 1)$ к $B_1$ и $W_m inter B_1$ оказалось бы непустым). Поэтому
  после этапа $n_0$ каждый элемент из $B_2$, который появляется в качестве
  значения функции $f$, должен сделать это _до того_, _как_ он появится в
  множестве $W_m$. С другой стороны, так как $overline(A) subset W_m$, всякий
  элемент из $overline(A)$ должен оказаться в $W_m$ _до того_, _как_ он появится
  в качестве значения $f$ (поскольку он вовсе не может быть значением функции
  $f$). Поэтому множество ${z | (exists n) [z in W_m^((n)) \& z in.not
      {f(0), ..., f(n + 1)}]}$ должно отличаться от $overline(A)$ самое большее
  на конечное множество. Поэтому, согласно второй теореме о проекции,
  $overline(A)$ должно быть рекурсивно перечислимым. Значит, $A$ должно быть
  рекурсивным в противоречие с условием. Таким образом, $B_1$ не может быть
  рекурсивным.

  Сходное рассуждение показывает, что и множество $B_2$ не рекурсивно.
]

Сакс#idx("Сакс", en: "Sacks G.") объединил теорему~@th:friedberg-splitting с
результатом упр.~@ex:sacks-special-case (о чем упоминалось в конце
упр.~@ex:sacks-special-case). Он показал, что всякое нерекурсивное рекурсивно
перечислимое множество $A$ есть объединение двух непересекающихся множеств,
причем эти непересекающиеся множества имеют несравнимые T-степени
неразрешимости, и T-степень каждого из них меньше, чем T-степень#idx(
  "T-сводимость",
  "степени",
  en: "degrees for",
) множества $A$. Мы не приводим здесь доказательство Сакса.

Прямое обобщение доказательства теоремы~@th:friedberg-splitting показывает, что
всякое нерекурсивное рекурсивно перечислимое множество может #source(296)быть
разложено в равномерно перечислимую бесконечную совокупность попарно не
пересекающихся нерекурсивных рекурсивно перечислимых множеств (см.
упр.~@ex:mclaughlin-decomposition).

#section[Сжатые множества] <sec:cohesive-sets>

Понятия _иммунности_ и _гипериммунности_#idx(
  "Гипериммунное множество",
  en: "hyperimmune set",
) могут быть усилены следующим образом.

#definition[
  Множество $A$ называется _сжатым_#idx(
    "Сжатые",
    "множества",
    en: "cohesive sets",
    range: "start",
  ), если
  #enum(numbering: "(i)")[
    $A$ бесконечно;
  ][
    $(forall B) [B$ рекурсивно перечислимо $=> [A inter B$ конечно или $A
    inter overline(B)$ конечно$]]$#footnote[
      Это понятие введено Роузом#idx(
        "Роуз",
        en: "Rose G.",
        note: true,
      ) и Юллианом#idx(
        "Юллиан",
        en: "Ullian J.",
        note: true,
      )~@bib:Rose1963. Оно связано с понятием _бесконечно неразложимого_#idx(
        "Рекурсивно",
        "неразложимое множество",
        en: "indecomposable set",
        note: true,
      ) множества, определенным Деккером#idx(
        "Деккер",
        en: "Dekker J.",
      ) и Майхиллом#idx("Майхилл", en: "Myhill J.")~@bib:Dekker1960.
      В~§~@sec:almost-finiteness мы покажем, что эти два понятия различны.
      Иногда со значением „сжатый“ используется также термин „_почти
      конечный_“#idx(
        "Почти-конечность",
        en: "almost-finiteness",
      ).
    ].
  ]
]

Таким образом, бесконечное множество сжато тогда и только тогда, когда оно не
может быть разделено рекурсивно перечислимым множеством на две бесконечные
части. Иными словами, множество сжато тогда и только тогда, когда оно
принадлежит такому элементу $a$ решетки $cal(N) slash cal(F)$, что $a != 0$ и
$a$ дизъюнктен со всяким рекурсивно перечислимым элементом, не превосходящим
$a$.

#theorem[
  $A$ сжато $=> A$ гипериммунно#idx(
    "Гипериммунное множество",
    en: "hyperimmune set",
  ).
] <th:cohesive-hyperimmune>

#proof[
  Допустим, что $A$ не гипериммунно. Тогда по
  теореме~@th:hyperimmune-disjoint-finite-sets существует такая общерекурсивная
  функция $f$, что
  $
    (forall x) (forall y) [x != y => D_(f(x)) inter D_(f(y)) = emptyset] \&
    (forall x) [D_(f(x)) inter A != emptyset].
  $
  Рассмотрим $B = limits(union.big)_(x "четно") D_(f(x))$. Тогда и $B inter
  A$, и $overline(B) inter A$ бесконечны. Значит, $A$ не сжато.
]

(Аналогичное рассуждение показывает, что $A$ сжато $=> A$ гипергипериммунно.)

Следующая теорема устанавливает существование сжатых множеств.

#theorem(title: [Деккер#idx("Деккер", en: "Dekker J.") и Майхилл#idx(
    "Майхилл",
    en: "Myhill J.",
  )])[
  Каждое бесконечное множество содержит сжатое подмножество.
] <th:cohesive-subset-exists>

#proof[
  Пусть $A$~— данное бесконечное множество. Определим последовательность $A_0$,
  $A_1$, ... следующим #source(297)образом:
  $
        A_0 & = A, \
    A_(n+1) & = cases(
                A_n inter W_n\, & "если" A_n inter W_n "бесконечно;",
                A_n inter overline(W)_n & "в противном случае."
              )
  $
  Очевидно, $A_0 supset A_1 supset A_2 supset ...$.

  Предположим, что $A$ не содержит ни одного сжатого подмножества. Тогда для
  каждого $n$ существует такое $z$, что $z >= n$ и $W_z$ разделяет $A_n$ на две
  бесконечные части. Отсюда следует, что последовательность $A_0$, $A_1$, $A_2$,
  ... содержит строго убывающую подпоследовательность $B_0$, $B_1$, $B_2$, ....
  Определим последовательность чисел $x_0$, $x_1$, ..., полагая
  $ x_n = mu y [y in B_n - B_(n+1)]. $
  Пусть $C$~— множество всех членов этой последовательности, т.~е. $C = {x_0,
    x_1, ...}$. Пусть дано произвольное $z$. Как явствует из построения,
  $A_(z+1) subset W_z$ или $A_(z+1) subset overline(W)_z$. Поэтому $B_(z+1)
  subset W_z$ или $B_(z+1) subset overline(W)_z$. Так как все, кроме конечного
  числа, элементы множества $C$ должны лежать в $B_(z+1)$, то либо $C inter
  W_z$, либо $C inter overline(W)_z$ конечно. Это верно для любого $z$, а потому
  $C$~— сжатое подмножество множества $A$, что противоречит нашему предположению
  об отсутствии у $A$ сжатого подмножества.
]

(Приведенное выше доказательство может быть сделано несколько более
конструктивным. Единственная информация о рекурсивно перечислимых множествах,
используемая здесь, заключается в том, что они образуют не более чем счетное
семейство. Будет заметно, что и многие другие доказательства, приводимые ниже,
являются по своей природе, подобно этому, чисто теоретико-множественными (во
всяком случае более, нежели относящимися к теории рекурсивных функций),
используя лишь счетность семейства рекурсивно перечислимых множеств и иногда
вдобавок его замкнутость относительно пересечений или тот факт, что оно содержит
все конечные и коконечные множества. Доказательство
теоремы~@th:cohesive-subset-exists обобщается в
упр.~@ex:dekker-countable-lower-bound и~@ex:iterated-almost-sets.)

Так как всякое бесконечное подмножество сжатого множества сжато, понятно, что
имеется $2^(aleph_0)$ сжатых множеств. Будем говорить, что сжатое множество $C$
_относится к_ рекурсивно перечислимому множеству $B$, если $C inter B$
бесконечно, т.~е. если элемент решетки $cal(N) slash cal(F)$, содержащий $C$,
лежит под элементом множества $B$. Назовем два сжатых множества
c-_эквивалентными_#idx(
  "c-эквивалентность",
  en: "c-equivalence",
  range: "start",
), если они относятся к одним и тем же рекурсивно перечислимым множествам.

#definition[
  Пусть $A$ и $B$ сжаты. Множество $A$ называется c-_эквивалентным_ $B$, если
  $(forall x) [A inter W_x$ бесконечно $<=> B inter W_x$ бесконечно$]$.
]

#theorem[
  #source(298)Пусть $A$ и $B$ сжаты. Тогда
  #enum(numbering: "(i)")[
    $A$ #roman[c]-эквивалентно $B <=> A union B$ сжато;
  ][
    $A inter B$ бесконечно $=> A union B$ сжато.
  ]
] <th:c-equivalence-union>

#proof[
  Непосредственно из определения. См. упр.~@ex:cohesive-union-proofs.
]

Если взять произвольный фиксированный класс c-эквивалентных сжатых множеств
вместе с конечными множествами, то получится идеал в $cal(N)$, факторизация
которого относительно $cal(F)$ дает идеал в $cal(N) slash cal(F)$. Каждый класс
c-эквивалентности содержит $2^(aleph_0)$ элементов. Как много существует классов
c-эквивалентности? Следующая теорема отвечает на этот вопрос.

#theorem[
  Сжатые множества распадаются на $2^(aleph_0)$ классов
  #roman[c]-эквивалентности.
] <th:continuum-c-classes>

#proof[
  Можно доказать эту теорему, пользуясь только простыми понятиями теории
  рекурсивных функций и теории множеств. Однако для сокращения доказательства
  удобно и полезно воспользоваться известными свойствами действительных и
  рациональных чисел.

  Заметим, что натуральные числа можно в следующем смысле эффективно отобразить
  на рациональные: существуют такие взаимно однозначное отображение $zeta$
  множества $N$ на рациональные числа и общерекурсивная функция $f$, что для
  всех $n$ $zeta(n) = pi_1 f(n) slash pi_2 f(n)$. (Можно воспользоваться любой
  из обычных нумераций множества рациональных чисел, чтобы получить такое
  отображение.)

  Зафиксируем некоторое такое отображение. Множества рациональных чисел могут
  быть теперь отождествлены с множествами натуральных чисел. В частности, всякий
  замкнутый интервал рациональных чисел с рациональными концами образует
  рекурсивное множество.

  Для каждого действительного числа выберем бесконечную сходящуюся
  последовательность рациональных чисел, имеющую данное действительное число
  пределом. Каждая из выбранных нами сходящихся последовательностей,
  рассматриваемая как множество сопоставленных ее элементам натуральных чисел,
  бесконечна, а потому по теореме~@th:cohesive-subset-exists каждая содержит
  сжатое подмножество. Выберем по одному сжатому подмножеству в каждой
  сходящейся последовательности. Сжатые множества, появившиеся из разных
  последовательностей, не могут быть c-эквивалентными, потому что их объединение
  может быть разделено на две бесконечные части подходящим интервалом с
  рациональными концами. Поскольку существует $2^(aleph_0)$ последовательностей
  (действительных чисел ведь существует $2^(aleph_0)$), найдется по крайней мере
  $2^(aleph_0)$ сжатых множеств, никакие два из которых не c-эквивалентны. Но
  классов #source(299)c-эквивалентности не может быть более $2^(aleph_0)$,
  потому что в $N$ имеется всего $2^(aleph_0)$ подмножеств.
]

Понятие сжатого множества доставляет средства для доказательства следующей
теоремы.

#theorem(title: [Кент#idx("Кент", en: "Kent C.")])[
  Существует такая перестановка $f$, что
  #enum(numbering: "(i)")[
    для всех рекурсивно перечислимых множеств $B$ множества $f(B)$ и $f^(-1)
    (B)$ рекурсивно перечислимы (а потому для всех рекурсивных множеств $A$
    множества $f(A)$ и $f^(-1) (A)$ рекурсивны)\;
  ][
    $f$ не рекурсивна.
  ]
] <th:kent-permutation>

#proof[
  Возьмем сжатое множество $D$. Рассмотрим
  $
    cal(D) = {f | f "—" #emph[перестановка] \& (forall x) [x in.not D => f(x)
        = x]}.
  $
  Так как $f$ из $cal(D)$ может быть определено на $D$ произвольным образом,
  $cal(D)$ содержит $2^(aleph_0)$ членов. Так как класс общерекурсивных функций
  счетен, $cal(D)$ содержит нерекурсивную перестановку. Остается проверить, что
  для любой $f$ из $cal(D)$ множества $f(A)$ и $f^(-1) (A)$ рекурсивны при любом
  рекурсивном множестве $A$ и $f(B)$ и $f^(-1) (B)$ рекурсивно перечислимы при
  любом рекурсивно перечислимом множестве $B$. Это непосредственно следует из
  сжатости множества $D$ (см. упр.~@ex:cohesive-union-proofs).
]

#corollary[
  Решетка $cal(E)$#idx(
    "Рекурсивно",
    "перечислимое",
    "множество",
    "решетка",
    en: "lattice of",
  ) обладает автоморфизмами, отличными от индуцированных рекурсивными
  перестановками#idx(
    "Рекурсивная",
    "перестановка",
    en: "recursive permutation",
  ) натурального ряда.
] <cor:non-recursive-automorphisms>

#proof[
  Непосредственно.
]

Следствие~@cor:non-recursive-automorphisms усилено в
упр.~@ex:automorphism-not-isomorphism, где показано, что существуют такие
рекурсивно перечислимые множества $A$ и $B$, что $A$ переводится в $B$ некоторым
автоморфизмом решетки $cal(E)$, но $A$ не рекурсивно изоморфно $B$. Отсюда
следует, что рекурсивно инвариантное свойство не обязательно теоретико-решеточно
в $cal(E)$.

#definition[
  Назовем сжатое множество $A$ _наполненным_#idx(
    "Сжатые",
    "множества",
    "наполненные",
    en: "completed",
  ), если $(forall B) [B$ сжато $\& A$ и $B$ c-эквивалентны $=> B inter
  overline(A)$ конечно$]$. Таким образом, класс c-эквивалентности содержит
  наполненное множество тогда и только тогда, когда идеал решетки $cal(N)
  slash cal(F)$, определенный этим классом эквивалентности, содержит
  максимальный элемент#footnote[
    То есть является _главным_ идеалом#idx(
      "Главный идеал",
      en: "principal ideal",
      note: true,
    ).
  ].
]

В~§~@sec:maximal-sets мы покажем, что наполненные множества существуют.
В~§~@sec:almost-finiteness будет установлено, что не всякий класс
c-эквивалентности содержит наполненное множество. В
упр.~@ex:countably-many-completed мы покажем, далее, что существует только
счетное число наполненных мно#source(300)жеств. В упр.~@ex:completed-comaximal
мы увидим, что $A$~— наполненное сжатое множество $=>
overline(A)$ рекурсивно перечислимо#idx(
  "Сжатые",
  "множества",
  "наполненные",
  en: "completed",
). Следующее понятие введено Роузом и Юллианом~@bib:Rose1963.

#definition[
  $A$ называется _квазисжатым_#idx(
    "Квазисжатое множество",
    en: "quasicohesive set",
  ), если $A$~— объединение конечного (ненулевого) числа сжатых множеств.
]

Если $A$ квазисжато, то всякое разложение множества $A$ на сжатые множества
определяет некоторую совокупность соответствующих классов c-эквивалентности. Из
теоремы~@th:c-equivalence-union следует, что это множество классов
c-эквивалентности#idx(
  "c-эквивалентность",
  en: "c-equivalence",
  range: "end",
) однозначно определено независимо от выбранного разложения (см.
упр.~@ex:quasicohesive-decomposition-unique).

Квазисжатые множества вместе с конечными множествами образуют идеал
$cal(F)_1$#notation($cal(F)_1$) в $cal(N)$\; это идеал, порожденный сжатыми
множествами. Можно построить факторрешетки $cal(N) slash cal(F)_1$, $cal(E)
slash cal(F)_1$#idx(
  "Рекурсивно",
  "перечислимое",
  "множество",
  "решетка",
  en: "lattice of",
), $cal(R) slash cal(F)_1$.

Квазисжатые множества гипериммунны#idx(
  "Гипериммунное множество",
  en: "hyperimmune set",
) (и даже гипергипериммунны#idx(
  "Гипергипериммунное множество",
  en: "hyperhyperimmune set",
)\; см. упр.~@ex:quasicohesive-hyperimmune). В упр.~@ex:generalized-cohesive мы
увидим, что множество может быть гипергипериммунным, не будучи квазисжатым.#idx(
  "Сжатые",
  "множества",
  en: "cohesive sets",
  range: "end",
)

#section[Максимальные множества] <sec:maximal-sets>

Теперь мы рассмотрим рекурсивно перечислимые множества со сжатыми дополнениями.

#definition[
  Множество $A$ называется _максимальным_#idx(
    "Максимальное",
    "множество",
    en: "maximal set",
    range: "start",
  ), если
  #enum(numbering: "(i)")[
    $A$ рекурсивно перечислимо;
  ][
    $overline(A)$ сжато.
  ]
]

#theorem[
  Множество $A$ максимально $<=> A$ принадлежит элементу решетки $cal(E) slash
  cal(F)$, максимальному среди неединичных элементов этой решетки.
] <th:maximal-iff-maximal-element>

#proof[
  $=>$. Если $A in a$ и $a$ не максимален среди неединичных элементов решетки
  $cal(E) slash cal(F)$, то найдется такой элемент $b$, что $a < b < one$.
  Возьмем такое $B in b$, что $A subset B$. Множества $N - B$ и $B - A$ должны
  быть бесконечными. Поэтому $overline(A) inter B$ бесконечно и $overline(A)
  inter overline(B)$ бесконечно. Значит, $overline(A)$ не сжато и $A$ не может
  быть максимальным.

  $arrow.l.double$. Если $A$ рекурсивно перечислимо, но не максимально, то
  $overline(A)$ не сжато. Пусть $C$~— такое рекурсивно перечислимое множество,
  что $overline(A) inter C$ и $overline(A) inter overline(C)$ бесконечны.
  Положим $B = A union C$. Пусть $b$~— содержащий $B$ элемент решетки $cal(E)
  slash cal(F)$. Тогда $a < b < one$, где $A in a$.
]

Существование максимальных множеств доказывается в следующей теореме,
принадлежащей Фридбергу#idx("Фридберг", en: "Friedberg R."). При доказательстве
мы воспользуемся одним изящным упрощением конструкции
Фридберга~@bib:Friedberg1958b, принадлежащим Ейтсу#idx(
  "Ейтс",
  en: "Yates C.",
)~@bib:Yates1965. Существование #source(301)полных максимальных множеств
(Ейтс#idx("Ейтс", en: "Yates C.")) и неполных максимальных множеств (Сакс#idx(
  "Сакс",
  en: "Sacks G.",
)) может быть установлено с помощью подходящих видоизменений этой конструкции\;
см. упр.~@ex:complete-incomplete-maximal.

#theorem[
  Существует максимальное множество.
] <th:maximal-set-exists>

#proof[
  Сначала мы опишем процедуру перечисления некоторого множества $A$, а затем
  докажем, что $A$ максимально.

  Перечисление $A$ происходит по этапам. Начнем с двух определений.

  #definition[
    $W_z^((n)) = {x | x$ _появляется за первые $n$ шагов в перечислении без
    повторений множества_ $W_z}$#footnote[
      Под „$n$ шагами перечисления без повторений множества $W_z$“ мы
      подразумеваем $n$ машинных тактов в следующей процедуре: вычисляйте
      $phi_(f''(z)) lr((0))$\; если и когда это вычисление закончится,
      вычисляйте $phi_(f''(z)) lr((1))$\; если и когда...\; $f''$ здесь
      определяется, как в следствии~@cor:enumeration-without-repetition.
    ].
  ]

  #definition[
    Для любого $z$, произвольного этапа $n + 1$ и любого натурального $x$
    определим _$z$-штат числа $x$ на этапе $n + 1$_ как конечную
    последовательность $b_0 b_1 ... b_z$ нулей и единиц, такую, что
    $
      b_i = cases(
        1\, & "если" x in W_i^((n+1)) & "и" & i <= n";",
        0\, & "если" x in.not W_i^((n+1)) & "или" & n < i",",
      )
    $
    где $0 <= i <= z$.
  ]

  Понятно, что имеется $2^(z+1)$ возможных $z$-штатов. Мы упорядочим их
  лексикографически (от „меньших“ к „бо́льшим“)\; например, 10111 считается
  _меньше_ чем 11000 (в упорядочении 4-штатов).

  Отметим два важных свойства $z$-штатов и их упорядочения: (i) для
  фиксированных $z$ и $x$ при $n < m$ $z$-штат элемента $x$ на этапе $m$ должен
  быть не меньше $z$-штата элемента $x$ на этапе $n$\; (ii) если при
  фиксированном этапе $n$, фиксированных $x$ и $y$ и $z < z'$ $z$-штат элемента
  $y$ больше, чем $z$-штат элемента $x$, то $z'$-штат элемента $y$ будет больше,
  чем $z'$-штат элемента $x$.

  Процедура перечисления множества $A$ такова. Мы начинаем со _списка_ всех
  натуральных чисел и считаем, что сопоставили каждому числу $x$ в этом списке
  маркер $marker(x)$. Мы опишем инструкции, в соответствии с которыми некоторые
  из этих маркеров будут сдвигаться. Если число из списка на каком-либо этапе
  окажется без маркера, оно уже останется без маркера навсегда. Числа из списка,
  (в конце концов) остающиеся без маркера, образуют множество $A$. (Хотя в нашем
  описании мы имеем в начальный момент бесконечно много маркеров и на данном
  этапе говорим о перемещении бесконечно многих маркеров, будет ясно, что мы
  #source(302)получим эффективный способ порождения $A$. Можно за счет
  некоторого увеличения сложности восприятия привести нашу процедуру к такому
  виду, в котором используется только конечное число маркеров на каждом этапе.)

  #run-in[Этап $n + 1$] Пусть для каждого $m$ $x_m^((n))$~— положение маркера
  $marker(m)$ к концу этапа $n$. Вычислим $W_z^((n+1))$ для всех $z <= n$.
  Найдем наименьшее из таких $m$ (если такие существуют), что для некоторого
  $q' > m$ число $x_(q')^((n))$ находится в большем $m$-штате (на этапе $n +
  1$), чем $x_m^((n))$. Если таких $m$ нет, переходим к этапу $n + 2$. Если же
  мы выбрали наименьшее такое $m$, то пусть $q$~— наименьшее из соответствующих
  ему $q'$\; перемещаем маркер $marker(m)$ на $x_q^((n))$, для всех $p > m$
  сдвигаем маркер $marker(p)$ на $x_(p+q-m)^((n))$. Относим к $A$ все элементы
  множества ${y | x_m^((n)) <= y < x_q^((n))}$, которые еще не попали в $A$.
  (Названные числа~— единственные в списке, теряющие маркер на этапе $n + 1$.)
  Затем переходим к этапу $n + 2$.

  Следующие две леммы показывают, что $A$ максимально.

  #lemma(numbered: true, number: 1)[
    $overline(A)$ бесконечно.
  ] <lem:complement-infinite>

  #proof(of: [леммы~@lem:complement-infinite], qed: false)[
    Как нетрудно заметить, достаточно показать, что каждый маркер сдвигается
    только конечное число раз. (Окончательное положение каждого маркера и есть
    элемент множества $overline(A)$.) Допустим противное. Пусть $m$~— наименьший
    из тех $m'$, для которых $marker(m')$ сдвигается бесконечно много раз. В
    соответствии со свойством (i) $z$-штатов, после того как $marker(m - 1)$
    достигнет своего окончательного положения, $marker(m)$ должно перемещаться в
    положения со все большими $m$-штатами. Но $m$-штатов имеется только конечное
    число. Получилось противоречие, и лемма доказана.
  ]

  #lemma(numbered: true, number: 2)[
    Для всякого $z$ либо $W_z inter overline(A)$, либо $overline(W)_z inter
    overline(A)$ конечно.
  ] <lem:complement-cohesive>

  #proof(of: [леммы~@lem:complement-cohesive], qed: false)[
    Зафиксируем $z$. Каждое число $x$ из $overline(A)$ должно достигнуть
    окончательного $z$-штата $beta$ по мере того, как $n$ возрастает. Скажем в
    этом случае, что $x$ _остановится_ в $beta$. Поскольку $overline(A)$
    бесконечно, хотя бы в одном $z$-штате остановится бесконечно много элементов
    множества $overline(A)$. Покажем, что не может быть больше одного $z$-штата,
    в котором остановится бесконечно много элементов из $overline(A)$. Допустим
    противное. Пусть $beta$~— наименьший из таких $z$-штатов, а $beta'$~— другой
    $z$-штат, в котором также остановится бесконечно много элементов из
    $overline(A)$. Отсюда следует, #source(303)что существуют такие числа $m$,
    $n$, $x$ и $y$, что $z < m <
    n$, $x$~— окончательное положение маркера $marker(m)$, $y$~— окончательное
    положение маркера $marker(n)$, $x$ окончательно остановится в $z$-штате
    $beta$, а $y$ остановится в $z$-штате $beta'$. По свойству (ii) $z$-штатов
    $y$ добирается до и останавливается в большем $m$-штате, чем $x$. Но это
    означает, согласно нашему построению, что маркер $marker(m)$ должен в конце
    концов сдвинуться, в противоречие с нашим предположением о том, что $x$~—
    его окончательное положение. Этим доказана лемма~@lem:complement-cohesive.
  ]

  Леммы~@lem:complement-infinite и~@lem:complement-cohesive показывают, что
  $overline(A)$~— сжатое множество. Значит, $A$~— максимальное множество.
]

#corollary(suffix: " (a)")[
  Решетка $cal(E) slash cal(F)$#idx(
    "Рекурсивно",
    "перечислимое",
    "множество",
    "решетка",
    en: "lattice of",
  ) не плотно упорядочена.
] <cor:not-dense>

#proof[
  В силу теорем~@th:dense-iff-no-maximal и~@th:maximal-iff-maximal-element.
]

#corollary(suffix: " (b)")[
  Существует наполненное#idx(
    "Сжатые",
    "множества",
    "наполненные",
    en: "completed",
  ) сжатое множество.
] <cor:completed-cohesive-exists>

#proof[
  Пусть множество $A$ максимально. Тогда $overline(A)$ сжато. Если
  $overline(A)$~— не наполненное множество, мы получим противоречие с
  теоремой~@th:c-equivalence-union, причем в роли разделяющего рекурсивно
  перечислимого множества выступит $A$.
]

Необычные свойства максимальных множеств бывают полезны при построении различных
примеров и контрпримеров (см. упр.~@ex:strongly-inseparable-pairs
и~@ex:completed-cohesive-partition и~§~@sec:almost-finiteness).

${A | A$ _максимально или коконечно_$}$ не является дуальным идеалом в $cal(E)$
(упр.~@ex:intersection-maximal). В этом отношении максимальные множества
отличаются от простых и гиперпростых множеств.

#definition[
  Множество $A$ называется _квазимаксимальным_#idx(
    "Квазимаксимальное множество",
    en: "quasimaximal set",
  ), если $A$ рекурсивно перечислимо, а $overline(A)$ квазисжато. Ниже, в
  упр.~@ex:intersection-maximal, мы показываем, что существуют
  квазимаксимальные, но не максимальные множества и что ${A | A$
  _квазимаксимально или коконечно_$}$ есть дуальный идеал в $cal(E)$.
]

#section[Подмножества максимальных множеств] <sec:subsets-of-maximal-sets>

#idx(
  "Максимальное",
  "множество",
  "его подмножества",
  en: "subsets of",
  range: "start",
)Всякий ли неединичный элемент решетки $cal(E) slash cal(F)$#idx(
  "Рекурсивно",
  "перечислимое",
  "множество",
  "решетка",
  en: "lattice of",
) содержится в некотором максимальном элементе? Иначе говоря, всякое ли
рекурсивно перечислимое множество с бесконечным дополнением содержится в
некотором максимальном множестве? Ответ на этот вопрос дает
теорема~@th:no-maximal-superset. Сначала, однако, мы докажем некоторые
родственные результаты.

#theorem[
  #source(304)#roman[(a)] Если рекурсивно перечислимое множество не просто и не
  коконечно, то оно содержится в некотором максимальном множестве.

  #roman[(b)] Если рекурсивно перечислимое множество не коконечно, то оно
  содержится в некотором гиперпростом#idx(
    "Гиперпростое множество",
    en: "hypersimple set",
  ) множестве.
] <th:maximal-superset>

#proof[
  (a) Пусть $A$~— рекурсивно перечислимое множество, причем $overline(A)$ не
  конечно и не иммунно. Тогда $overline(A)$ содержит некоторое бесконечное
  рекурсивное множество $B$. Пусть $f$~— рекурсивная функция, взаимно однозначно
  отображающая $N$ на $B$, и пусть $C$~— образ в $B$ (при отображении $f$)
  некоторого максимального множества. Тогда $overline(B) union
  C$~— искомое максимальное множество, содержащее $A$.

  (b) Пусть $A$~— рекурсивно перечислимое множество с бесконечным дополнением
  $overline(A)$. Предположим, что $A$ не гиперпросто (в противном случае нечего
  доказывать). Воспользовавшись упр.~@ex:hyperimmune-finite-sets, возьмем такую
  общерекурсивную функцию $f$, что $D_(f(0))$, $D_(f(1))$, ...~—
  последовательность попарно не пересекающихся конечных множеств, каждое из
  которых пересекается с $overline(A)$ и объединение которых есть $N$. Пусть
  $B$~— некоторое гиперпростое множество. Положим $C = A union limits(
    union.big
  )_(i in B) D_(f(i))$. Тогда $C$~— искомое гиперпростое множество, содержащее
  $A$ (упр.~@ex:hypersimple-superset).
]

#definition(word: "Определения")[
  $|A| = [$мощность множества $A]$.#notation($|A|, overline(lim) (A)$)

  $overline(lim) (f, A) = limits(lim)_(n -> infinity) (limits(sup)_(m > n)
    |W_(f(m)) inter A|)$. (Таким образом, неравенство $overline(lim) (f, A) >=
  p$ означает, что для бесконечно многих значений $m$ $W_(f(m)) inter A$
  содержит по крайней мере $p$ элементов.)

  Функция $f$ называется _рекурсивно перечислимой последовательностью без
  пересечений_, если $f$ общерекурсивна и
  $
    (forall u) (forall v) [u != v => W_(f(u)) inter W_(f(v)) = emptyset].
  $

  $overline(lim) (A) = limits(sup)_(f in cal(D)) (overline(lim) (f, A))$, где
  $cal(D)$~— совокупность всех рекурсивно перечислимых последовательностей без
  пересечений. (Так что неравенство $overline(lim) (A) >= p$ означает, что
  $overline(lim) (f, A) >= p$ для некоторой рекурсивно перечислимой
  последовательности $f$ без пересечений.) Отсюда получаем, например, что
  $overline(lim) (A) = 0 <=> A$ конечно.
]

Следующие теоремы, доказанные Мартином#idx(
  "Мартин",
  en: "Martin D.",
  range: "start",
)~@bib:Martin1963, отвечают на наш первоначальный вопрос.

#theorem(title: [Мартин])[
  $A$ максимально $=> overline(lim) (overline(A)) = 1$.
] <th:maximal-lim-one>

#proof[
  По определению множество $overline(A)$ сжато. Допустим, что $overline(lim)
  (overline(A)) >= 2$. Тогда для некоторой последова#source(305)тельности $f$
  без пересечений $overline(lim) (f, overline(A)) >= 2$. Определим рекурсивно
  перечислимое множество $B$ следующим образом.

  Перечисляем $A$\; в то же время начинаем перечислять множества $W_(f(0))$,
  $W_(f(1))$, .... На каждом этапе для каждого $i$ относим некоторые элементы
  множества $W_(f(i))$ к $B$ по следующему правилу. Каждое число, появившееся и
  в $A$, и в $W_(f(i))$, зачисляем в $B$, а также относим к $B$ первое число,
  которое появилось в $W_(f(i))$, но еще не появилось в $A$ (если такие
  найдутся)#footnote[
    Это предложение надо понимать так: пусть $x_0$~— первое (в порядке
    перечисления множества $W_(f(i))$) число, появившееся в $W_(f(i))^((n))$, но
    не попавшее в $A^((n))$\; относим $x_0$ к $B$\; если $x_0$ позже попадет в
    $A$, то зачисляем в $B$ число $x_1$~— первое (в порядке перечисления
    $W_(f(i))$) из отличных от $x_0$ и не попавших в $A$ к моменту своего
    появления в $W_(f(i))$\; если $x_1$ позже попадет в $A$, то ... и т.~д.~—
    _Прим. перев._
  ]. Поскольку для бесконечно многих $i$ множество $W_(f(i))$ содержит хотя бы
  два элемента из $overline(A)$, бесконечно много элементов из $overline(A)$
  попадет в $B$ и бесконечно много элементов $overline(A)$ никогда не попадет в
  $B$. Но, значит, $B$ разделяет $overline(A)$ на две бесконечные части, что
  противоречит сжатости множества $overline(A)$. Поэтому
  $overline(lim) (overline(A)) <= 1$. Так как $overline(A)$ бесконечно,
  $overline(lim) (overline(A)) > 0$. Значит, $overline(lim)
  (overline(A)) = 1$.
]

#theorem(title: [Мартин])[
  Существует такое рекурсивно перечислимое множество $A$, что $overline(A)$
  бесконечно и $A$ не содержится ни в каком максимальном множестве.
] <th:no-maximal-superset>

#proof[
  Мы укажем такое рекурсивно перечислимое множество $A$, что $overline(A)$
  бесконечно и для всякого рекурсивно перечислимого $B$ имеем $B supset A =>
  overline(lim) (overline(B)) != 1$. Отсюда будет следовать искомый результат в
  силу теоремы~@th:maximal-lim-one. Дадим инструкции для перечисления множества
  $A$.

  Определим последовательность попарно не пересекающихся конечных множеств
  $
    S_0 & = {0}, \
    S_1 & = {1, 2}, \
    S_2 & = {3, 4, 5}, \
        & ...,
  $
  где при каждом $n$ множество $S_n$ содержит $n + 1$ элементов. Будем
  перечислять множества $W_0$, $W_1$, $W_2$, .... На каждом этапе для каждого
  $i$ проверяем, нет ли такого $j < i$, чтобы точно $i$ из $i + 1$ членов
  множества $S_i$ были уже перечислены в $W_j$\; для каждого такого $j$ относим
  к $A$ тот элемент $S_i$, который еще не попал в $W_j$.

  Так как $S_i$ содержит $i + 1$ элементов и не более $i$ из них может попасть в
  $A$ (по одному для каждого $j < i$), $overline(A)$ должно быть беско#source(
    306,
  )нечным. (Ясно, что по теореме~@th:hyperimmune-disjoint-finite-sets $A$ не
  гиперпросто.) Пусть $B$~— такое рекурсивно перечислимое множество, что
  $B supset A$. Тогда $B =
  W_j$ для некоторого $j$ и, согласно построению, для всех $i > j$ либо $S_i
  subset B$, либо $S_i inter overline(B)$ содержит хотя бы два элемента. Поэтому
  или $overline(B)$ конечно (и $overline(lim) (overline(B)) = 0$), или для
  бесконечно многих $i$ множество $S_i inter overline(B)$ содержит хотя бы два
  элемента (и $overline(lim) (overline(B)) >= 2$). В обоих случаях
  $overline(lim) (overline(B)) != 1$, и теорема доказана.
]

За счет небольших изменений в построении этот результат может быть следующим
образом усилен.

#corollary(title: [Мартин])[
  #roman[(a)] Если рекурсивно перечислимое множество не гиперпросто и не
  коконечно, то оно содержится в таком простом негиперпростом множестве $C$, что
  $C$ не содержится ни в каком максимальном множестве.

  #roman[(b)] Если рекурсивно перечислимое множество не гиперпросто и не
  коконечно, то оно содержится в таком гиперпростом#idx(
    "Гиперпростое множество",
    en: "hypersimple set",
  ) множестве $D$, что $D$ не содержится ни в каком максимальном множестве.
] <cor:simple-no-maximal-superset>

#proof[
  (a) Пусть рекурсивно перечислимое множество $B$ не является ни коконечным, ни
  гиперпростым. Возьмем (по теореме~@th:hyperimmune-disjoint-finite-sets)
  некоторую эффективно занумерованную каноническими индексами последовательность
  попарно не пересекающихся конечных множеств, каждое из которых пересекается с
  $overline(B)$. Беря объединения этих конечных множеств, построим эффективную
  последовательность попарно не пересекающихся конечных множеств $S'_0$, $S'_1$,
  ..., для которой при каждом $n$ множество $S'_n inter overline(B)$ содержит
  хотя бы $n + 1$ элементов и $(forall x)
  (exists i) [x in S'_i]$. Построим множество $A$ по последовательности $S'_0$,
  $S'_1$, ... так же, как это было сделано при доказательстве
  теоремы~@th:no-maximal-superset. Положим $C = A union B$. В силу построения из
  теоремы~@th:no-maximal-superset $C$ не коконечно и не содержится ни в каком
  максимальном множестве. Поэтому по теореме~@th:maximal-superset~(a) $C$
  просто. Последовательность $S'_0$, $S'_1$, ... указывает (с помощью
  теоремы~@th:hyperimmune-disjoint-finite-sets), что $C$ не гиперпросто.

  (b) Немедленно следует из (a) и теоремы~@th:maximal-superset~(b).
]

Известно, что обращение теоремы~@th:maximal-lim-one (для рекурсивно перечислимых
множеств) неверно. Всякое ли не коконечное рекурсивно перечислимое множество
содержится в некотором гипергиперпростом#idx(
  "Гипергиперпростое множество",
  en: "hyperhypersimple set",
) множестве? Мартин~@bib:Martin1963 усилил
следствие~@cor:simple-no-maximal-superset, заменив в нем „максимальный“ на
„гипергиперпростой“.

Рассмотрим для произвольного элемента $a$ решетки $cal(E) slash cal(F)$#idx(
  "Рекурсивно",
  "перечислимое",
  "множество",
  "решетка",
  en: "lattice of",
) максимальные цепи неединичных элементов, лежащих между $a$ и единичным
элементом. (Существование таких максимальных цепей легко доказывается.)
Теорема~@th:no-maximal-superset показывает, что существуют такие неединичные
элементы, что ни одна из этих максимальных цепей не может иметь наибольшего
элемента. Существуют ли #source(307)в $cal(E) slash cal(F)$ неединичные
элементы, обладающие плотными максимальными цепями#footnote[
  _Цепью_#idx("Решетка", "цепь", en: "chain in", note: true) в решетке называют
  линейно упорядоченное подмножество. Цепь, лежащая между двумя элементами,
  называется максимальной, если не существует другой цепи между теми же
  элементами, полученной из данной добавлением нового элемента. Цепь называется
  _плотной_, если между любыми двумя ее элементами лежит третий элемент цепи.
]? Существуют ли неединичные элементы, у которых все максимальные цепи плотны?
Эти вопросы пока открыты#footnote[
  На второй (а следовательно, и на первый) из этих вопросов дал утвердительный
  ответ М.~М.~Арсланов#idx("Арсланов М. М.")~@bib:Arslanov1969. Именно, он
  показал, что если взять множество $A$ со свойствами, описанными в
  теореме~@th:no-maximal-superset, то для содержащего это множество элемента
  решетки $cal(E) slash cal(F)$ всякая максимальная цепь является плотной. Как
  сообщил редактору М.~М.~Арсланов#idx("Арсланов М. М."), содержащееся в его
  тезисах~@bib:Arslanov1969 утверждение, что все максимальные цепи являются
  плотными лишь для множеств $A$ со свойствами, описанными в
  теореме~@th:no-maximal-superset, неверно.~— _Прим. ред._
].

Можно ли высказать предположение о строении решетки $cal(E) slash
cal(F)$#idx(
  "Рекурсивно",
  "перечислимое",
  "множество",
  "решетка",
  en: "lattice of",
), аналогичное гипотезе Шёнфильда#idx(
  "Шёнфильд",
  "гипотеза",
  en: "conjecture",
) о строении совокупности T-степеней, упорядоченной отношением T-сводимости
(§~@sec:further-results)? Нерегулярности, определяемые существованием
максимальных элементов и элементов, не содержащихся в максимальных, делают
затруднительным выдвижение такой гипотезы.

Насколько широко распространены максимальные множества среди степеней
неразрешимости#idx(
  "Степени",
  "неразрешимости",
  en: "degrees of unsolvability",
)? Ниже мы приводим в этой связи теорему~@th:young-m-equivalent. (Мы
сформулируем более общий результат, принадлежащий Мартину, в
гл.~@ch:degrees-of-unsolvability.) Существуют ли T-полные максимальные
множества? Существуют ли максимальные множества неполных T-степеней#idx(
  "T-сводимость",
  "степени",
  en: "degrees for",
)? Существуют ли рекурсивно перечислимые нерекурсивные T-степени, не содержащие
максимальных множеств? Положительные ответы на эти три вопроса были получены
Ейтсом#idx("Ейтс", en: "Yates C.")~@bib:Yates1965, Саксом#idx(
  "Сакс",
  en: "Sacks G.",
)~@bib:Sacks1964b и Мартином [1965].

#theorem(title: [Янг#idx("Янг", en: "Young P.")])[
  Если $A$ рекурсивно перечислимо, но не рекурсивно, а $B$ максимально и $A
  <=_(upright(m)) B$#idx("m-сводимость", en: "m-reducibility"), то $A
  equiv_(upright(m)) B$.
] <th:young-m-equivalent>

#proof[
  Пусть $f$ m-сводит $A$ к $B$. Множество $f(overline(A))$ должно быть
  бесконечным (иначе $overline(A)$ было бы рекурсивно перечислимым). Поэтому
  $C = overline(B) - f(overline(A))$ должно быть конечным (иначе рекурсивно
  перечислимое множество $f(N)$ разделяло бы сжатое множество $overline(B)$).
  Пусть $m$~— некоторый фиксированный элемент из $A$, а $n$~— фиксированный
  элемент из $overline(A)$. Определим рекурсивную функцию $g$ следующим образом.
  Для вычисления $g(y)$ проверим, верно ли, что $y in C$\; если это так, положим
  $g(y) = n$\; если нет, начинаем перечислять $B$ и в то же время начинаем
  поиски такого $x$, что $f(x) = y$\; если $y$ появится в $B$ прежде, чем такой
  $x$ будет найден, полагаем $g(y) = m$\; в противном случае найдется такой $x$
  (так как $overline(B) - C subset f(N)$), и мы полагаем $g(y)$ равным первому
  такому $x$. Функция $g$ m-сводит $B$ к $A$.#idx(
    "Максимальное",
    "множество",
    en: "maximal set",
    range: "end",
  )#idx(
    "Максимальное",
    "множество",
    "его подмножества",
    en: "subsets of",
    range: "end",
  )#idx("Мартин", en: "Martin D.", range: "end")
]
